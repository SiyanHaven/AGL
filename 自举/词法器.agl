#语言=中文
// 自举：用 AGL 写 AGL 词法分析器。
// 目标不是一次覆盖所有细节，而是先让「AGL 读 AGL 源码」在 AGB/VM 上真实跑通。
// 记号是普通映射表，不依赖宿主语言。

模块 词法器

函数 是标识符起始(字符: 文本) -> 布尔 {
  返回 是字母(字符) 或 字符 等于 "_"
}

函数 是标识符内容(字符: 文本) -> 布尔 {
  返回 是字母(字符) 或 是数字(字符) 或 字符 等于 "_"
}

函数 是空白(字符: 文本) -> 布尔 {
  变量 码 = 字符码(字符)
  返回 码 等于 32 或 码 等于 9 或 码 等于 10 或 码 等于 13
}

// 跳过空白，返回 [新位置, 新行, 新列]。
// 用列表而不是结构体，保持自举代码对 AGB 的依赖最小。
函数 跳过空白(源码: 文本, 位置: 整数, 行: 整数, 列: 整数) -> 列表 {
  变量 游标 = 位置
  变量 行号 = 行
  变量 列号 = 列
  当 游标 小于 源码.长度 {
    变量 字符 = 源码[游标]
    如果 是空白(字符) {
      如果 字符码(字符) 等于 10 {
        行号 += 1
        列号 = 1
      } 否则 {
        列号 += 1
      }
      游标 += 1
    } 否则 {
      返回 [游标, 行号, 列号]
    }
  }
  返回 [游标, 行号, 列号]
}

导出 函数 词法分析(源码: 文本) -> 列表 {
  变量 记号们 = []
  变量 位置 = 0
  变量 行 = 1
  变量 列 = 1
  变量 长度 = 源码.长度
  变量 双字符符号们 = ["==", "!=", ">=", "<=", "&&", "||", "+=", "-=", "*=", "/=", "%=", "=>", "->"]

  当 位置 小于 长度 {
    变量 跳过结果 = 跳过空白(源码, 位置, 行, 列)
    位置 = 跳过结果[0]
    行 = 跳过结果[1]
    列 = 跳过结果[2]
    如果 位置 大于等于 长度 {
      中断
    }

    变量 字符 = 源码[位置]
    变量 记号行 = 行
    变量 记号列 = 列

    // 行注释 `//`
    如果 字符 等于 "/" 并且 位置 + 1 小于 长度 并且 源码[位置 + 1] 等于 "/" {
      位置 += 2
      列 += 2
      当 位置 小于 长度 并且 字符码(源码[位置]) 不等于 10 {
        位置 += 1
        列 += 1
      }
      继续
    }

    // 文件头 `#语言=中文`：第一行不是代码，整行跳过
    如果 字符 等于 "#" {
      当 位置 小于 长度 并且 字符码(源码[位置]) 不等于 10 {
        位置 += 1
        列 += 1
      }
      继续
    }

    // 块注释 `/* ... */`
    如果 字符 等于 "/" 并且 位置 + 1 小于 长度 并且 源码[位置 + 1] 等于 "*" {
      位置 += 2
      列 += 2
      变量 已闭合 = 假
      当 位置 小于 长度 并且 非 已闭合 {
        如果 源码[位置] 等于 "*" 并且 位置 + 1 小于 长度 并且 源码[位置 + 1] 等于 "/" {
          位置 += 2
          列 += 2
          已闭合 = 真
        } 否则 {
          如果 字符码(源码[位置]) 等于 10 {
            行 += 1
            列 = 1
          } 否则 {
            列 += 1
          }
          位置 += 1
        }
      }
      继续
    }

    // 文本字面量
    如果 字符 等于 "\"" {
      变量 字面内容 = "\""
      位置 += 1
      列 += 1
      变量 引号结束 = 假
      当 位置 小于 长度 并且 非 引号结束 {
        变量 字面字符 = 源码[位置]
        如果 字面字符 等于 "\"" {
          字面内容 += "\""
          位置 += 1
          列 += 1
          引号结束 = 真
        } 否则 如果 字面字符 等于 "\\" 并且 位置 + 1 小于 长度 {
          字面内容 += 字面字符 + 源码[位置 + 1]
          位置 += 2
          列 += 2
        } 否则 {
          字面内容 += 字面字符
          如果 字符码(字面字符) 等于 10 {
            行 += 1
            列 = 1
          } 否则 {
            列 += 1
          }
          位置 += 1
        }
      }
      记号们 = 追加(记号们, {"类型": "文本", "文本": 字面内容, "行": 记号行, "列": 记号列})
      继续
    }

    // 数字：整数或浮数，支持小数点与指数
    如果 是数字(字符) {
      变量 数字值 = ""
      当 位置 小于 长度 {
        变量 当前字符 = 源码[位置]
        如果 是数字(当前字符) 或 当前字符 等于 "." {
          数字值 += 当前字符
          位置 += 1
          列 += 1
          继续
        }
        如果 (当前字符 等于 "e" 或 当前字符 等于 "E") 并且 位置 + 1 小于 长度 {
          数字值 += 当前字符
          位置 += 1
          列 += 1
          变量 指数符号 = 源码[位置]
          如果 指数符号 等于 "+" 或 指数符号 等于 "-" {
            数字值 += 指数符号
            位置 += 1
            列 += 1
          }
          继续
        }
        中断
      }
      记号们 = 追加(记号们, {"类型": "数字", "文本": 数字值, "行": 记号行, "列": 记号列})
      继续
    }

    // 标识符 / 关键字 / 中文运算符词
    如果 是标识符起始(字符) {
      变量 名字 = ""
      当 位置 小于 长度 并且 是标识符内容(源码[位置]) {
        名字 += 源码[位置]
        位置 += 1
        列 += 1
      }
      记号们 = 追加(记号们, {"类型": "标识符", "文本": 名字, "行": 记号行, "列": 记号列})
      继续
    }

    // 分号只是语句分隔符，不进入语义记号流
    如果 字符 等于 ";" {
      位置 += 1
      列 += 1
      继续
    }

    // 双字符符号
    如果 位置 + 1 小于 长度 {
      变量 两字符 = 字符 + 源码[位置 + 1]
      如果 包含(双字符符号们, 两字符) {
        记号们 = 追加(记号们, {"类型": "符号", "文本": 两字符, "行": 记号行, "列": 记号列})
        位置 += 2
        列 += 2
        继续
      }
    }

    // 单字符符号
    记号们 = 追加(记号们, {"类型": "符号", "文本": 字符, "行": 记号行, "列": 记号列})
    位置 += 1
    列 += 1
  }

  记号们 = 追加(记号们, {"类型": "结束", "文本": "", "行": 行, "列": 列})
  返回 记号们
}

函数 主入口() 效应 读写 {
  变量 路径们 = [
    "tests/golden/hello_zh.agl",
    "tests/golden/full_zh.agl",
    "tests/golden/grammar_zh.agl",
    "自举/词法器.agl"
  ]
  循环 路径 在 路径们 {
    变量 源码 = 取到(读文件(路径))
    变量 记号们 = 词法分析(源码)
    变量 摘要文本 = ""
    循环 记号 在 记号们 {
      摘要文本 += "|" + 记号["文本"]
    }
    打印(路径, "记号数", 记号们.长度, "摘要", SHA256(摘要文本))
  }
}
