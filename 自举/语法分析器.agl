#语言=中文
// 自举：用 AGL 写 AGL 语法分析器（递归下降，先覆盖主干语法）。
// 输入是词法器产出的记号表，输出是普通映射表组成的 AST。
// 目标：让「AGL 读 AGL 源码并生成语法树」真实跑在 AGB/VM 上。

导入 词法器
// 英文关键字 → 中文关键字：词法器把词标成「标识符」，这里只做关键字归一，
// 用户标识符和字符串字面量不经过这张表。
函数 规范词(原: 文本) -> 文本 {
  变量 长度 = 原.长度
  如果 长度 等于 0 {
    返回 原
  }
  变量 首码 = 字符码(原[0])
  如果 首码 大于 127 {
    返回 原
  }
  如果 原 等于 "Any" {
    返回 "任意"
  }
  如果 原 等于 "Bool" {
    返回 "布尔"
  }
  如果 原 等于 "Err" {
    返回 "失败"
  }
  如果 原 等于 "Error" {
    返回 "错误"
  }
  如果 原 等于 "External" {
    返回 "外部调用"
  }
  如果 原 等于 "Float" {
    返回 "浮数"
  }
  如果 原 等于 "IO" {
    返回 "读写"
  }
  如果 原 等于 "Int" {
    返回 "整数"
  }
  如果 原 等于 "List" {
    返回 "列表"
  }
  如果 原 等于 "Map" {
    返回 "映射表"
  }
  如果 原 等于 "Net" {
    返回 "网络"
  }
  如果 原 等于 "Null" {
    返回 "空"
  }
  如果 原 等于 "Ok" {
    返回 "成功"
  }
  如果 原 等于 "Result" {
    返回 "结果"
  }
  如果 原 等于 "Set" {
    返回 "集合"
  }
  如果 原 等于 "String" {
    返回 "文本"
  }
  如果 原 等于 "Time" {
    返回 "计时"
  }
  如果 原 等于 "agent" {
    返回 "智能体"
  }
  如果 原 等于 "as" {
    返回 "作为"
  }
  如果 原 等于 "async" {
    返回 "异步"
  }
  如果 原 等于 "await" {
    返回 "等待"
  }
  如果 原 等于 "break" {
    返回 "中断"
  }
  如果 原 等于 "catch" {
    返回 "捕获"
  }
  如果 原 等于 "check" {
    返回 "校验"
  }
  如果 原 等于 "config" {
    返回 "配置"
  }
  如果 原 等于 "const" {
    返回 "常量"
  }
  如果 原 等于 "continue" {
    返回 "继续"
  }
  如果 原 等于 "deps" {
    返回 "依赖"
  }
  如果 原 等于 "effect" {
    返回 "效应"
  }
  如果 原 等于 "else" {
    返回 "否则"
  }
  如果 原 等于 "export" {
    返回 "导出"
  }
  如果 原 等于 "false" {
    返回 "假"
  }
  如果 原 等于 "ffi" {
    返回 "外部"
  }
  如果 原 等于 "finally" {
    返回 "最后"
  }
  如果 原 等于 "fn" {
    返回 "函数"
  }
  如果 原 等于 "for" {
    返回 "循环"
  }
  如果 原 等于 "if" {
    返回 "如果"
  }
  如果 原 等于 "import" {
    返回 "导入"
  }
  如果 原 等于 "in" {
    返回 "在"
  }
  如果 原 等于 "input" {
    返回 "入参"
  }
  如果 原 等于 "interface" {
    返回 "接口"
  }
  如果 原 等于 "let" {
    返回 "变量"
  }
  如果 原 等于 "main" {
    返回 "主入口"
  }
  如果 原 等于 "match" {
    返回 "匹配"
  }
  如果 原 等于 "model" {
    返回 "模型"
  }
  如果 原 等于 "module" {
    返回 "模块"
  }
  如果 原 等于 "on_fail" {
    返回 "当任务失败"
  }
  如果 原 等于 "on_finish" {
    返回 "当任务完成"
  }
  如果 原 等于 "on_progress" {
    返回 "当收到进度"
  }
  如果 原 等于 "print" {
    返回 "打印"
  }
  如果 原 等于 "return" {
    返回 "返回"
  }
  如果 原 等于 "rule" {
    返回 "规则"
  }
  如果 原 等于 "tool" {
    返回 "工具"
  }
  如果 原 等于 "true" {
    返回 "真"
  }
  如果 原 等于 "try" {
    返回 "尝试"
  }
  如果 原 等于 "type" {
    返回 "类型"
  }
  如果 原 等于 "while" {
    返回 "当"
  }
  如果 原 等于 "with" {
    返回 "使用"
  }
  返回 原
}

函数 看当前(状态: 列表) -> 映射表 {
  变量 记号们 = 状态[0]
  变量 位置 = 状态[1]
  如果 位置 大于等于 记号们.长度 {
    返回 {"类型": "结束", "文本": ""}
  }
  返回 记号们[位置]
}

函数 取文本(状态: 列表) -> 文本 {
  变量 记号 = 看当前(状态)
  变量 原 = 记号["文本"]
  如果 记号["类型"] 等于 "标识符" {
    返回 规范词(原)
  }
  返回 原
}

函数 前进(状态: 列表) {
  状态[1] = 状态[1] + 1
}

函数 期望文本(状态: 列表, 目标: 文本) -> 布尔 {
  如果 取文本(状态) 不等于 目标 {
    // 解析失败不再只是打印——记录结构化错误到 状态[3]（首个错误优先），
    // 错误码对齐种子编译器：缺块起始用 AGL-E-0205，其余期望落空用 AGL-E-0201。
    如果 状态[3] 等于 空 {
      变量 记号 = 看当前(状态)
      变量 码 = "AGL-E-0201"
      如果 目标 等于 "{" {
        码 = "AGL-E-0205"
      }
      如果 目标 等于 "}" {
        码 = "AGL-E-0202"
      }
      状态[3] = {"错误码": 码, "行": 记号["行"],
                 "期望": 目标, "实际": 取文本(状态)}
    }
    打印("解析错误：期望", 目标, "实际", 取文本(状态))
    返回 假
  }
  前进(状态)
  返回 真
}

函数 解析类型(状态: 列表) -> 文本 {
  变量 型名 = 取文本(状态)
  前进(状态)
  如果 取文本(状态) 等于 "<" {
    前进(状态)
    当 取文本(状态) 不等于 ">" 并且 取文本(状态) 不等于 "" {
      前进(状态)
    }
    如果 取文本(状态) 等于 ">" {
      前进(状态)
    }
  }
  // 可空类型后缀 `文本?`：自举侧只关心能不能解析，运行期不需要可空标记。
  如果 取文本(状态) 等于 "?" {
    前进(状态)
  }
  返回 型名
}

函数 解析参数们(状态: 列表) -> 列表 {
  变量 参数们 = []
  当 取文本(状态) 不等于 ")" 并且 取文本(状态) 不等于 "" {
    变量 参名 = 取文本(状态)
    前进(状态)
    期望文本(状态, ":")
    变量 参型 = 解析类型(状态)
    参数们 = 追加(参数们, {"名字": 参名, "类型": 参型})
    如果 取文本(状态) 等于 "," {
      前进(状态)
    }
  }
  返回 参数们
}

函数 解析块(状态: 列表) -> 列表 {
  期望文本(状态, "{")
  变量 语句们 = 解析语句们(状态)
  期望文本(状态, "}")
  返回 语句们
}

函数 解析如果(状态: 列表) -> 映射表 {
  期望文本(状态, "如果")
  变量 条件 = 解析表达式(状态)
  变量 那么支 = 解析块(状态)
  变量 另一支 = []
  如果 取文本(状态) 等于 "否则" {
    前进(状态)
    如果 取文本(状态) 等于 "如果" {
      另一支 = [解析如果(状态)]
    } 否则 {
      另一支 = 解析块(状态)
    }
  }
  返回 {"种类": "如果", "条件": 条件, "那么": 那么支, "否则": 另一支}
}

函数 解析函数(状态: 列表, 已导出: 布尔, 异步标记: 布尔) -> 映射表 {
  期望文本(状态, "函数")
  变量 被调名 = 取文本(状态)
  前进(状态)
  期望文本(状态, "(")
  变量 参数们 = 解析参数们(状态)
  期望文本(状态, ")")
  变量 产出类型 = "任意"
  变量 效应列表 = []
  变量 校验们 = []
  如果 取文本(状态) 等于 "->" {
    前进(状态)
    产出类型 = 解析类型(状态)
  }
  变量 继续签名 = 真
  当 继续签名 {
    如果 取文本(状态) 等于 "校验" {
      前进(状态)
      变量 校验语句们 = 解析块(状态)
      循环 校验语句 在 校验语句们 {
        如果 校验语句["种类"] 等于 "表达式" {
          校验们 = 追加(校验们, 校验语句["值"])
        }
      }
    } 否则 如果 取文本(状态) 等于 "效应" {
      前进(状态)
      当 取文本(状态) 不等于 "{" 并且 取文本(状态) 不等于 "" 并且 取文本(状态) 不等于 "校验" {
        效应列表 = 追加(效应列表, 取文本(状态))
        前进(状态)
      }
    } 否则 {
      继续签名 = 假
    }
  }
  变量 体 = 解析块(状态)
  返回 {"种类": "函数", "名字": 被调名, "参数": 参数们,
        "返回": 产出类型, "效应": 效应列表, "校验": 校验们, "体": 体, "导出": 已导出,
        "异步": 异步标记}
}

函数 解析类型声明(状态: 列表) -> 映射表 {
  期望文本(状态, "类型")
  变量 类型名 = 取文本(状态)
  前进(状态)
  期望文本(状态, "{")
  变量 字段们 = []
  当 取文本(状态) 不等于 "}" 并且 取文本(状态) 不等于 "" {
    变量 字段名 = 取文本(状态)
    前进(状态)
    期望文本(状态, ":")
    变量 字段类型 = 解析类型(状态)
    字段们 = 追加(字段们, {"名字": 字段名, "类型": 字段类型})
    如果 取文本(状态) 等于 "," {
      前进(状态)
    }
  }
  期望文本(状态, "}")
  返回 {"种类": "类型声明", "名字": 类型名, "字段": 字段们}
}

函数 是增加赋值(原文本: 文本) -> 布尔 {
  返回 包含(["+=", "-=", "*=", "/=", "%="], 原文本)
}

函数 解析列表模式(状态: 列表) -> 映射表 {
  变量 项们 = []
  当 取文本(状态) 不等于 "]" 并且 取文本(状态) 不等于 "" {
    变量 项 = 空
    如果 取文本(状态) 等于 "变量" {
      前进(状态)
      变量 项名 = 取文本(状态)
      前进(状态)
      项 = {"种类": "绑定", "名字": 项名}
    } 否则 如果 取文本(状态) 等于 "[" {
      前进(状态)
      项 = {"种类": "列表", "模式": 解析列表模式(状态)}
    } 否则 如果 取文本(状态) 等于 "{" {
      前进(状态)
      项 = {"种类": "映射", "模式": 解析映射模式(状态)}
    } 否则 {
      变量 项值 = 解析表达式(状态)
      如果 项值["种类"] 等于 "名字" {
        如果 项值["名字"] 等于 "_" {
          项 = {"种类": "通配"}
        } 否则 {
          项 = {"种类": "字面量", "值": 项值}
        }
      } 否则 {
        项 = {"种类": "字面量", "值": 项值}
      }
    }
    项们 = 追加(项们, 项)
    如果 取文本(状态) 等于 "," {
      前进(状态)
    } 否则 {
      中断
    }
  }
  期望文本(状态, "]")
  返回 {"种类": "列表模式", "项": 项们}
}

函数 解析映射模式(状态: 列表) -> 映射表 {
  变量 条目们 = []
  当 取文本(状态) 不等于 "}" 并且 取文本(状态) 不等于 "" {
    变量 键 = 解析表达式(状态)
    期望文本(状态, ":")
    变量 值 = 空
    如果 取文本(状态) 等于 "变量" {
      前进(状态)
      变量 值名 = 取文本(状态)
      前进(状态)
      值 = {"种类": "绑定", "名字": 值名}
    } 否则 如果 取文本(状态) 等于 "[" {
      前进(状态)
      值 = {"种类": "列表", "模式": 解析列表模式(状态)}
    } 否则 如果 取文本(状态) 等于 "{" {
      前进(状态)
      值 = {"种类": "映射", "模式": 解析映射模式(状态)}
    } 否则 {
      变量 值表达式 = 解析表达式(状态)
      如果 值表达式["种类"] 等于 "名字" {
        如果 值表达式["名字"] 等于 "_" {
          值 = {"种类": "通配"}
        } 否则 {
          值 = {"种类": "字面量", "值": 值表达式}
        }
      } 否则 {
        值 = {"种类": "字面量", "值": 值表达式}
      }
    }
    条目们 = 追加(条目们, {"键": 键, "值": 值})
    如果 取文本(状态) 等于 "," {
      前进(状态)
    } 否则 {
      中断
    }
  }
  期望文本(状态, "}")
  返回 {"种类": "映射模式", "条目": 条目们}
}

函数 解析语句(状态: 列表) -> 映射表 {
  如果 取文本(状态) 等于 "模块" {
    前进(状态)
    变量 块名 = 取文本(状态)
    前进(状态)
    返回 {"种类": "模块", "名字": 块名}
  }
  如果 取文本(状态) 等于 "导入" {
    前进(状态)
    如果 取文本(状态) 等于 "外部" {
      前进(状态)
      变量 外部模块名 = 取文本(状态)
      前进(状态)
      状态[2] = 追加(状态[2], 外部模块名)
      返回 {"种类": "导入外部", "名字": 外部模块名}
    }
    变量 引入名 = 取文本(状态)
    前进(状态)
    返回 {"种类": "导入", "名字": 引入名}
  }
  如果 取文本(状态) 等于 "导出" {
    前进(状态)
    返回 解析函数(状态, 真, 假)
  }
  如果 取文本(状态) 等于 "异步" {
    前进(状态)
    如果 取文本(状态) 等于 "导出" {
      前进(状态)
      返回 解析函数(状态, 真, 真)
    }
    返回 解析函数(状态, 假, 真)
  }
  如果 取文本(状态) 等于 "类型" {
    返回 解析类型声明(状态)
  }
  如果 取文本(状态) 等于 "函数" {
    返回 解析函数(状态, 假, 假)
  }
  如果 取文本(状态) 等于 "变量" {
    前进(状态)
    变量 声明名 = 取文本(状态)
    前进(状态)
    // 解包声明：`变量 甲, 乙 = 值`（右侧是列表等可解包值），对齐种子 let_multi。
    变量 名单 = [声明名]
    当 取文本(状态) 等于 "," {
      前进(状态)
      名单 = 追加(名单, 取文本(状态))
      前进(状态)
    }
    // 类型标注可选（规格 3.5）：`变量 数量: 整数 = 0`、`let first: String? = Null`。
    // 自举侧只消费注解，不进 IR —— 运行期是动态值，静态校验由种子编译器负责。
    如果 取文本(状态) 等于 ":" {
      前进(状态)
      解析类型(状态)
    }
    期望文本(状态, "=")
    变量 初值 = 解析表达式(状态)
    如果 名单.长度 等于 1 {
      返回 {"种类": "变量", "名字": 名单[0], "值": 初值}
    }
    返回 {"种类": "变量解包", "名字们": 名单, "值": 初值}
  }
  如果 取文本(状态) 等于 "常量" {
    // 常量在自举侧按变量编译：静态不可变校验归种子编译器，运行期无差别。
    前进(状态)
    变量 常量名 = 取文本(状态)
    前进(状态)
    如果 取文本(状态) 等于 ":" {
      前进(状态)
      解析类型(状态)
    }
    期望文本(状态, "=")
    变量 常量值 = 解析表达式(状态)
    返回 {"种类": "变量", "名字": 常量名, "值": 常量值}
  }
  如果 取文本(状态) 等于 "接口" {
    // 接口契约（纯编译期，自举侧解析 + 记录，签名校验归种子）。
    前进(状态)
    变量 契约名 = 取文本(状态)
    前进(状态)
    变量 成员们 = []
    期望文本(状态, "{")
    当 取文本(状态) 不等于 "}" 并且 取文本(状态) 不等于 "" {
      期望文本(状态, "函数")
      变量 成员名 = 取文本(状态)
      前进(状态)
      期望文本(状态, "(")
      变量 成员参数 = []
      当 取文本(状态) 不等于 ")" 并且 取文本(状态) 不等于 "" {
        变量 成员参名 = 取文本(状态)
        前进(状态)
        期望文本(状态, ":")
        变量 成员参型 = 解析类型(状态)
        成员参数 = 追加(成员参数, {"名字": 成员参名, "类型": 成员参型})
        如果 取文本(状态) 等于 "," {
          前进(状态)
        } 否则 {
          中断
        }
      }
      期望文本(状态, ")")
      变量 成员返回 = "任意"
      如果 取文本(状态) 等于 "->" {
        前进(状态)
        成员返回 = 解析类型(状态)
      }
      成员们 = 追加(成员们, {"名字": 成员名, "参数们": 成员参数, "返回": 成员返回})
    }
    期望文本(状态, "}")
    返回 {"种类": "声明", "声明种类": "接口", "名字": 契约名, "成员们": 成员们}
  }
  如果 取文本(状态) 等于 "依赖" {
    // 顶层依赖块（版本锁定；解析 + 记录，版本校验归种子）。
    前进(状态)
    期望文本(状态, "{")
    变量 依赖们 = []
    当 取文本(状态) 不等于 "}" 并且 取文本(状态) 不等于 "" {
      变量 包名 = 取文本(状态)
      前进(状态)
      期望文本(状态, "=")
      依赖们 = 追加(依赖们, {"名字": 包名, "版本": 解析表达式(状态)})
    }
    期望文本(状态, "}")
    返回 {"种类": "声明", "声明种类": "依赖", "依赖们": 依赖们}
  }
  如果 取文本(状态) 等于 "返回" {
    前进(状态)
    变量 产出值 = {"种类": "空"}
    如果 取文本(状态) 不等于 "}" 并且 取文本(状态) 不等于 "" {
      产出值 = 解析表达式(状态)
    }
    返回 {"种类": "返回", "值": 产出值}
  }
  如果 取文本(状态) 等于 "如果" {
    返回 解析如果(状态)
  }
  如果 取文本(状态) 等于 "尝试" {
    前进(状态)
    变量 尝试体 = 解析块(状态)
    变量 捕获名 = ""
    变量 捕获类型 = ""
    变量 捕获体 = []
    如果 取文本(状态) 等于 "捕获" {
      前进(状态)
      期望文本(状态, "(")
      捕获名 = 取文本(状态)
      前进(状态)
      如果 取文本(状态) 等于 ":" {
        前进(状态)
        捕获类型 = 取文本(状态)
        前进(状态)
      }
      期望文本(状态, ")")
      捕获体 = 解析块(状态)
    }
    变量 否则体 = []
    如果 取文本(状态) 等于 "否则" {
      前进(状态)
      否则体 = 解析块(状态)
    }
    变量 最后体 = []
    如果 取文本(状态) 等于 "最后" {
      前进(状态)
      最后体 = 解析块(状态)
    }
    返回 {"种类": "尝试", "体": 尝试体, "捕获名": 捕获名,
          "捕获类型": 捕获类型, "捕获": 捕获体,
          "否则": 否则体, "最后": 最后体}
  }
  如果 取文本(状态) 等于 "匹配" {
    前进(状态)
    期望文本(状态, "(")
    变量 匹配主体 = 解析表达式(状态)
    期望文本(状态, ")")
    期望文本(状态, "{")
    变量 分支们 = []
    当 取文本(状态) 不等于 "}" 并且 取文本(状态) 不等于 "" {
      如果 取文本(状态) 等于 "否则" {
        前进(状态)
        如果 取文本(状态) 等于 "如果" {
          前进(状态)
          变量 顶部守卫 = 解析表达式(状态)
          变量 顶部体 = 解析块(状态)
          分支们 = 追加(分支们, {"模式": {"种类": "名字", "名字": "_"},
            "体": 顶部体, "守卫": 顶部守卫, "绑定": ""})
          继续
        }
        变量 顶部否则体 = 解析块(状态)
        分支们 = 追加(分支们, {"模式": {"种类": "名字", "名字": "_"},
          "体": 顶部否则体, "守卫": 空, "绑定": ""})
        中断
      }
      变量 绑定名 = ""
      变量 模式 = 空
      如果 取文本(状态) 等于 "变量" {
        前进(状态)
        绑定名 = 取文本(状态)
        前进(状态)
        模式 = {"种类": "名字", "名字": "_"}
      }
      如果 取文本(状态) 等于 "[" 并且 模式 等于 空 {
        前进(状态)
        模式 = 解析列表模式(状态)
      }
      如果 取文本(状态) 等于 "{" 并且 模式 等于 空 {
        前进(状态)
        模式 = 解析映射模式(状态)
      }
      如果 模式 等于 空 {
        模式 = 解析表达式(状态)
      }
      变量 守卫 = 空
      如果 取文本(状态) 等于 "如果" {
        前进(状态)
        守卫 = 解析表达式(状态)
      }
      变量 分支体 = 解析块(状态)
      分支们 = 追加(分支们, {"模式": 模式, "体": 分支体,
        "守卫": 守卫, "绑定": 绑定名})
      如果 取文本(状态) 等于 "否则" {
        前进(状态)
        如果 取文本(状态) 等于 "如果" {
          前进(状态)
          变量 否则守卫 = 解析表达式(状态)
          变量 否则如果体 = 解析块(状态)
          分支们 = 追加(分支们, {"模式": {"种类": "名字", "名字": "_"},
            "体": 否则如果体, "守卫": 否则守卫, "绑定": ""})
          继续
        }
        变量 否则体 = 解析块(状态)
        分支们 = 追加(分支们, {"模式": {"种类": "名字", "名字": "_"},
          "体": 否则体, "守卫": 空, "绑定": ""})
        中断
      }
    }
    期望文本(状态, "}")
    返回 {"种类": "匹配", "主体": 匹配主体, "分支们": 分支们}
  }
  如果 取文本(状态) 等于 "当任务完成" {
    前进(状态)
    期望文本(状态, "(")
    变量 任务值 = 解析表达式(状态)
    期望文本(状态, ",")
    变量 回调参数 = 取文本(状态)
    前进(状态)
    期望文本(状态, ":")
    变量 参数类型 = 解析类型(状态)
    期望文本(状态, ")")
    变量 回调体 = 解析块(状态)
    返回 {"种类": "当任务完成", "任务": 任务值, "参数名": 回调参数,
          "参数类型": 参数类型, "体": 回调体}
  }
  如果 取文本(状态) 等于 "当任务失败" {
    前进(状态)
    期望文本(状态, "(")
    变量 任务值 = 解析表达式(状态)
    期望文本(状态, ",")
    变量 回调参数 = 取文本(状态)
    前进(状态)
    期望文本(状态, ":")
    变量 参数类型 = 解析类型(状态)
    期望文本(状态, ")")
    变量 回调体 = 解析块(状态)
    返回 {"种类": "当任务失败", "任务": 任务值, "参数名": 回调参数,
          "参数类型": 参数类型, "体": 回调体}
  }
  如果 取文本(状态) 等于 "使用" {
    前进(状态)
    变量 使用值 = 解析表达式(状态)
    变量 使用名 = ""
    如果 取文本(状态) 等于 "作为" {
      前进(状态)
      使用名 = 取文本(状态)
      前进(状态)
    }
    变量 使用体 = 解析块(状态)
    返回 {"种类": "使用", "值": 使用值, "名字": 使用名, "体": 使用体}
  }
  如果 取文本(状态) 等于 "当" {
    前进(状态)
    变量 条件 = 解析表达式(状态)
    变量 体 = 解析块(状态)
    返回 {"种类": "当", "条件": 条件, "体": 体}
  }
  如果 取文本(状态) 等于 "循环" {
    前进(状态)
    变量 环名 = 取文本(状态)
    前进(状态)
    期望文本(状态, "在")
    变量 来源 = 解析表达式(状态)
    变量 体 = 解析块(状态)
    返回 {"种类": "循环每个", "名字": 环名, "集合": 来源, "体": 体}
  }
  如果 取文本(状态) 等于 "继续" {
    前进(状态)
    返回 {"种类": "继续"}
  }
  如果 取文本(状态) 等于 "中断" {
    前进(状态)
    返回 {"种类": "中断"}
  }

  变量 目标 = 解析表达式(状态)
  如果 取文本(状态) 等于 "=" {
    前进(状态)
    变量 值 = 解析表达式(状态)
    返回 {"种类": "赋值", "目标": 目标, "值": 值}
  }
  如果 是增加赋值(取文本(状态)) {
    变量 算子 = 取文本(状态)
    前进(状态)
    变量 值 = 解析表达式(状态)
    返回 {"种类": "增加赋值", "目标": 目标, "算子": 算子, "值": 值}
  }
  返回 {"种类": "表达式", "值": 目标}
}

函数 解析语句们(状态: 列表) -> 列表 {
  变量 语句们 = []
  当 取文本(状态) 不等于 "}" 并且 取文本(状态) 不等于 "" {
    变量 之前位置 = 状态[1]
    语句们 = 追加(语句们, 解析语句(状态))
    如果 状态[1] 等于 之前位置 {
      中断
    }
  }
  返回 语句们
}

函数 解析声明块(状态: 列表) -> 映射表 {
  // 声明块（工具/智能体/规则）已解析成声明节点，
  // 不再按花括号深度整块跳过；静态校验（重复名/配置字段/规则禁项）仍归种子编译器，
  // 运行期声明块不产生代码 —— 中间表示记录、字节码层忽略。
  变量 声明词 = 取文本(状态)
  前进(状态)
  变量 声明名 = 取文本(状态)
  前进(状态)
  变量 参数们 = []
  变量 产出类型 = "任意"
  变量 配置 = 空
  变量 目标 = 空
  变量 字段们 = 空
  期望文本(状态, "{")
  当 取文本(状态) 不等于 "}" 并且 取文本(状态) 不等于 "" {
    如果 取文本(状态) 等于 "入参" {
      前进(状态)
      期望文本(状态, "(")
      当 取文本(状态) 不等于 ")" 并且 取文本(状态) 不等于 "" {
        变量 参名 = 取文本(状态)
        前进(状态)
        期望文本(状态, ":")
        变量 参型 = 解析类型(状态)
        参数们 = 追加(参数们, {"名字": 参名, "类型": 参型})
        如果 取文本(状态) 等于 "," {
          前进(状态)
        } 否则 {
          中断
        }
      }
      期望文本(状态, ")")
      继续
    }
    如果 取文本(状态) 等于 "返回" {
      前进(状态)
      产出类型 = 解析类型(状态)
      继续
    }
    如果 取文本(状态) 等于 "配置" {
      前进(状态)
      期望文本(状态, "{")
      配置 = {}
      当 取文本(状态) 不等于 "}" 并且 取文本(状态) 不等于 "" {
        变量 配置键 = 取文本(状态)
        前进(状态)
        期望文本(状态, "=")
        配置[配置键] = 解析表达式(状态)
      }
      期望文本(状态, "}")
      继续
    }
    如果 取文本(状态) 等于 "目标" {
      前进(状态)
      期望文本(状态, "=")
      目标 = 解析表达式(状态)
      继续
    }
    // 规则块的其余字段：键 = 值
    变量 字段键 = 取文本(状态)
    前进(状态)
    期望文本(状态, "=")
    如果 字段键 等于 "生效范围" 或 字段键 等于 "scope" {
      变量 范围值 = 解析表达式(状态)
      // 「模块 名字」「目标 名字」两级写法：层级后面跟限定名。
      // 判据：当前记号是标识符，且它后面那个记号不是 =（= 说明它是下一个字段键）。
      变量 记号们 = 状态[0]
      变量 位置 = 状态[1]
      如果 位置 < 记号们.长度 并且 记号们[位置]["类型"] 等于 "标识符" 并且 位置 + 1 < 记号们.长度 {
        如果 记号们[位置 + 1]["文本"] 不等于 "=" {
          前进(状态)
        }
      }
      如果 字段们 等于 空 {
        字段们 = {}
      }
      字段们[字段键] = 范围值
      继续
    }
    如果 字段们 等于 空 {
      字段们 = {}
    }
    字段们[字段键] = 解析表达式(状态)
  }
  期望文本(状态, "}")
  变量 节点 = {"种类": "声明", "声明种类": 声明词, "名字": 声明名,
              "参数们": 参数们, "返回": 产出类型}
  如果 配置 不等于 空 {
    节点["配置"] = 配置
  }
  如果 目标 不等于 空 {
    节点["目标"] = 目标
  }
  如果 字段们 不等于 空 {
    节点["字段们"] = 字段们
  }
  返回 节点
}

导出 函数 解析程序带错误(记号们: 列表) -> 列表 {
  // 返回 [节点们, 错误]。错误为 空 表示解析干净；
  // 有错时错误含 错误码/行/期望/实际，自举编译器入口据此报中文诊断。
  变量 状态 = [记号们, 0, [], 空]
  变量 节点们 = []
  当 取文本(状态) 不等于 "" {
    变量 首词 = 取文本(状态)
    如果 首词 等于 "工具" 或 首词 等于 "智能体" 或 首词 等于 "规则" {
      节点们 = 追加(节点们, 解析声明块(状态))
      继续
    }
    变量 之前位置 = 状态[1]
    节点们 = 追加(节点们, 解析语句(状态))
    如果 状态[1] 等于 之前位置 {
      中断
    }
  }
  返回 [节点们, 状态[3]]
}

导出 函数 解析程序(记号们: 列表) -> 列表 {
  // 兼容入口：老调用方（编译器/中间表示/字节码.agl）只要节点列表。
  返回 解析程序带错误(记号们)[0]
}

函数 解析列表(状态: 列表) -> 映射表 {
  期望文本(状态, "[")
  变量 元素们 = []
  如果 取文本(状态) 不等于 "]" {
    元素们 = 追加(元素们, 解析表达式(状态))
    当 取文本(状态) 等于 "," {
      前进(状态)
      元素们 = 追加(元素们, 解析表达式(状态))
    }
  }
  期望文本(状态, "]")
  返回 {"种类": "列表", "元素": 元素们}
}

函数 解析映射(状态: 列表) -> 映射表 {
  期望文本(状态, "{")
  变量 对们 = []
  变量 元素们 = []
  如果 取文本(状态) 等于 "}" {
    前进(状态)
    返回 {"种类": "映射", "对": 对们}
  }
  变量 首项 = 解析表达式(状态)
  如果 取文本(状态) 等于 ":" {
    前进(状态)
    变量 首值 = 解析表达式(状态)
    对们 = 追加(对们, [首项, 首值])
    当 取文本(状态) 等于 "," {
      前进(状态)
      变量 后续键 = 解析表达式(状态)
      期望文本(状态, ":")
      变量 后续值 = 解析表达式(状态)
      对们 = 追加(对们, [后续键, 后续值])
    }
    期望文本(状态, "}")
    返回 {"种类": "映射", "对": 对们}
  }
  元素们 = 追加(元素们, 首项)
  当 取文本(状态) 等于 "," {
    前进(状态)
    如果 取文本(状态) 等于 "}" {
      中断
    }
    元素们 = 追加(元素们, 解析表达式(状态))
  }
  期望文本(状态, "}")
  返回 {"种类": "集合", "元素": 元素们}
}

函数 解析调用(状态: 列表, 被调: 映射表) -> 映射表 {
  期望文本(状态, "(")
  变量 实参们 = []
  如果 取文本(状态) 不等于 ")" {
    变量 首个实参 = 解析表达式(状态)
    如果 取文本(状态) 等于 ":" {
      前进(状态)
      变量 命名值 = 解析表达式(状态)
      首个实参 = {"种类": "命名参数", "名字": 首个实参["名字"], "值": 命名值}
    }
    实参们 = 追加(实参们, 首个实参)
    当 取文本(状态) 等于 "," {
      前进(状态)
      变量 下一个实参 = 解析表达式(状态)
      如果 取文本(状态) 等于 ":" {
        前进(状态)
        变量 命名值二 = 解析表达式(状态)
        下一个实参 = {"种类": "命名参数", "名字": 下一个实参["名字"], "值": 命名值二}
      }
      实参们 = 追加(实参们, 下一个实参)
    }
  }
  期望文本(状态, ")")
  返回 {"种类": "调用", "目标": 被调, "参数": 实参们}
}

函数 解析匹配表达式(状态: 列表) -> 映射表 {
  前进(状态)  // 匹配
  变量 主体 = 解析表达式(状态)
  期望文本(状态, "{")
  变量 分支们 = []
  变量 完成 = 假
  当 取文本(状态) 不等于 "}" 并且 完成 等于 假 {
    变量 模式 = {"种类": "通配"}
    变量 绑定 = ""
    变量 守卫 = 空
    变量 停止 = 假
    如果 取文本(状态) 等于 "否则" {
      前进(状态)
      如果 取文本(状态) 等于 "如果" {
        前进(状态)
        守卫 = 解析表达式(状态)
      } 否则 {
        停止 = 真
      }
    } 否则 如果 取文本(状态) 等于 "变量" {
      前进(状态)
      绑定 = 取文本(状态)
      前进(状态)
    } 否则 如果 取文本(状态) 等于 "[" {
      前进(状态)
      模式 = 解析列表模式(状态)
    } 否则 如果 取文本(状态) 等于 "{" {
      前进(状态)
      模式 = 解析映射模式(状态)
    } 否则 {
      模式 = 解析表达式(状态)
    }
    如果 取文本(状态) 等于 "如果" 并且 守卫 等于 空 {
      前进(状态)
      守卫 = 解析表达式(状态)
    }
    期望文本(状态, "=>")
    变量 体 = 解析表达式(状态)
    分支们 = 追加(分支们, {"模式": 模式, "绑定": 绑定, "守卫": 守卫, "体": 体})
    如果 停止 {
      完成 = 真
    }
    如果 取文本(状态) 等于 "," {
      前进(状态)
    }
  }
  期望文本(状态, "}")
  返回 {"种类": "匹配表达式", "主体": 主体, "分支": 分支们}
}

函数 解析基本(状态: 列表) -> 映射表 {
  变量 记号 = 看当前(状态)
  变量 记号类型 = 记号["类型"]
  变量 基值 = {"种类": "空"}
  如果 取文本(状态) 等于 "匹配" {
    基值 = 解析匹配表达式(状态)
  } 否则 如果 记号类型 等于 "数字" {
    前进(状态)
    基值 = {"种类": "数字", "文本": 记号["文本"]}
  } 否则 如果 记号类型 等于 "文本" {
    前进(状态)
    基值 = {"种类": "文本", "文本": 记号["文本"]}
  } 否则 如果 取文本(状态) 等于 "(" {
    前进(状态)
    基值 = 解析表达式(状态)
    期望文本(状态, ")")
  } 否则 如果 取文本(状态) 等于 "[" {
    基值 = 解析列表(状态)
  } 否则 如果 取文本(状态) 等于 "{" {
    基值 = 解析映射(状态)
  } 否则 如果 取文本(状态) 等于 "真" {
    前进(状态)
    基值 = {"种类": "真假", "值": 真}
  } 否则 如果 取文本(状态) 等于 "假" {
    前进(状态)
    基值 = {"种类": "真假", "值": 假}
  } 否则 如果 取文本(状态) 等于 "空" {
    前进(状态)
    基值 = {"种类": "空"}
  } 否则 {
    变量 名字 = 取文本(状态)
    前进(状态)
    基值 = {"种类": "名字", "名字": 名字}
  }

  // 后缀：成员 / 下标 / 调用可以任意串联（`节点["参数"].长度`）
  变量 还在 = 真
  当 还在 {
    如果 取文本(状态) 等于 "." {
      前进(状态)
      变量 成员名 = 取文本(状态)
      前进(状态)
      如果 基值["种类"] 等于 "名字" 并且 包含(状态[2], 基值["名字"]) {
        基值 = {"种类": "成员", "对象": 基值, "名字": 成员名, "外部": 基值["名字"]}
      } 否则 {
        基值 = {"种类": "成员", "对象": 基值, "名字": 成员名}
      }
    } 否则 如果 取文本(状态) 等于 "[" {
      前进(状态)
      变量 下标 = 解析表达式(状态)
      期望文本(状态, "]")
      基值 = {"种类": "下标", "目标": 基值, "下标": 下标}
    } 否则 如果 取文本(状态) 等于 "(" {
      基值 = 解析调用(状态, 基值)
    } 否则 {
      还在 = 假
    }
  }
  返回 基值
}

函数 解析一元(状态: 列表) -> 映射表 {
  如果 取文本(状态) 等于 "等待" {
    前进(状态)
    变量 等待值 = 解析一元(状态)
    返回 {"种类": "等待", "值": 等待值}
  }
  如果 取文本(状态) 等于 "非" 或 取文本(状态) 等于 "!" 或 取文本(状态) 等于 "-" {
    变量 算子 = 取文本(状态)
    前进(状态)
    变量 操作数 = 解析一元(状态)
    返回 {"种类": "一元", "算子": 算子, "操作数": 操作数}
  }
  返回 解析基本(状态)
}

函数 解析乘除(状态: 列表) -> 映射表 {
  变量 左 = 解析一元(状态)
  当 取文本(状态) 等于 "*" 或 取文本(状态) 等于 "/" 或 取文本(状态) 等于 "%" {
    变量 算子 = 取文本(状态)
    前进(状态)
    变量 右 = 解析一元(状态)
    左 = {"种类": "二元", "算子": 算子, "左": 左, "右": 右}
  }
  返回 左
}

函数 解析加减(状态: 列表) -> 映射表 {
  变量 左 = 解析乘除(状态)
  当 取文本(状态) 等于 "+" 或 取文本(状态) 等于 "-" {
    变量 算子 = 取文本(状态)
    前进(状态)
    变量 右 = 解析乘除(状态)
    左 = {"种类": "二元", "算子": 算子, "左": 左, "右": 右}
  }
  返回 左
}

函数 是比较(原文本: 文本) -> 布尔 {
  返回 包含(["==", "!=", ">", "<", ">=", "<=",
               "等于", "不等于", "大于", "小于", "大于等于", "小于等于"], 原文本)
}

函数 解析比较(状态: 列表) -> 映射表 {
  变量 左 = 解析加减(状态)
  当 是比较(取文本(状态)) {
    变量 算子 = 取文本(状态)
    前进(状态)
    变量 右 = 解析加减(状态)
    左 = {"种类": "二元", "算子": 算子, "左": 左, "右": 右}
  }
  返回 左
}

函数 解析与(状态: 列表) -> 映射表 {
  变量 左 = 解析比较(状态)
  当 取文本(状态) 等于 "并且" 或 取文本(状态) 等于 "&&" {
    前进(状态)
    变量 右 = 解析比较(状态)
    左 = {"种类": "二元", "算子": "&&", "左": 左, "右": 右}
  }
  返回 左
}

函数 解析或(状态: 列表) -> 映射表 {
  变量 左 = 解析与(状态)
  当 取文本(状态) 等于 "或" 或 取文本(状态) 等于 "||" {
    前进(状态)
    变量 右 = 解析与(状态)
    左 = {"种类": "二元", "算子": "||", "左": 左, "右": 右}
  }
  返回 左
}

函数 解析表达式(状态: 列表) -> 映射表 {
  返回 解析或(状态)
}

函数 主入口() 效应 读写 {
  变量 路径们 = ["tests/golden/hello_zh.agl", "tests/golden/full_zh.agl",
                 "自举/词法器.agl", "自举/语法分析器.agl"]
  循环 路径 在 路径们 {
    变量 源码 = 取到(读文件(路径))
    变量 记号们 = 词法器.词法分析(源码)
    变量 节点们 = 解析程序(记号们)
    打印(路径, "顶层节点", 节点们.长度)
    循环 节点 在 节点们 {
      如果 节点["种类"] 等于 "函数" {
        打印("  函数", 节点["名字"], "参数", 节点["参数"].长度, "语句", 节点["体"].长度)
      } 否则 {
        打印("  节点", 节点["种类"], 节点["名字"])
      }
    }
  }
}
