函数 编译表达式(状态: 映射表, 函数状态: 映射表, 节点: 映射表) {
  变量 种类 = 节点["expr"]
  如果 种类 等于 "named" {
    编译表达式(状态, 函数状态, 节点["value"])
    返回
  }
  如果 种类 等于 "int" 或 种类 等于 "float" 或 种类 等于 "string" 或 种类 等于 "bool" {
    发射(函数状态, {"op": "LOAD_CONST", "arg": 取常量(状态, 节点["value"])}, 0)
    返回
  }
  如果 种类 等于 "null" {
    发射(函数状态, {"op": "LOAD_CONST", "arg": 0}, 0)
    返回
  }
  如果 种类 等于 "name" {
    如果 包含(函数状态["局部们"], 节点["name"]) {
      发射(函数状态, {"op": "LOAD_NAME", "arg": 取名字(状态, 节点["name"])}, 0)
    } 否则 如果 包含(状态["函数名们"], 节点["name"]) {
      发射(函数状态, {"op": "LOAD_FUNC", "arg": 取名字(状态, 节点["name"])}, 0)
    } 否则 {
      发射(函数状态, {"op": "LOAD_NAME", "arg": 取名字(状态, 节点["name"])}, 0)
    }
    返回
  }
  如果 种类 等于 "list" {
    变量 元素们 = 节点["items"]
    循环 元素 在 元素们 {
      编译表达式(状态, 函数状态, 元素)
    }
    发射(函数状态, {"op": "BUILD_LIST", "arg": 元素们.长度}, 0)
    返回
  }
  如果 种类 等于 "set" {
    变量 元素们 = 节点["items"]
    循环 元素 在 元素们 {
      编译表达式(状态, 函数状态, 元素)
    }
    发射(函数状态, {"op": "BUILD_SET", "arg": 元素们.长度}, 0)
    返回
  }
  如果 种类 等于 "map" {
    变量 对们 = 节点["entries"]
    循环 对 在 对们 {
      编译表达式(状态, 函数状态, 对["key"])
      编译表达式(状态, 函数状态, 对["value"])
    }
    发射(函数状态, {"op": "BUILD_MAP", "arg": 对们.长度}, 0)
    返回
  }
  如果 种类 等于 "index" {
    编译表达式(状态, 函数状态, 节点["target"])
    编译表达式(状态, 函数状态, 节点["index"])
    发射(函数状态, {"op": "INDEX"}, 0)
    返回
  }
  如果 种类 等于 "member" {
    如果 节点["field"] 等于 "长度" 或 节点["field"] 等于 "length" {
      编译表达式(状态, 函数状态, 节点["target"])
      发射(函数状态, {"op": "LENGTH"}, 0)
      返回
    }
    编译表达式(状态, 函数状态, 节点["target"])
    发射(函数状态, {"op": "GET_FIELD", "arg": 取名字(状态, 节点["field"])}, 0)
    返回
  }
  如果 种类 等于 "unop" {
    编译表达式(状态, 函数状态, 节点["operand"])
    如果 节点["op"] 等于 "!" {
      发射(函数状态, {"op": "NOT"}, 0)
    } 否则 {
      发射(函数状态, {"op": "NEG"}, 0)
    }
    返回
  }
  如果 种类 等于 "await" {
    编译表达式(状态, 函数状态, 节点["value"])
    发射(函数状态, {"op": "AWAIT"}, 0)
    返回
  }
  如果 种类 等于 "binop" {
    如果 节点["op"] 等于 "&&" {
      编译表达式(状态, 函数状态, 节点["left"])
      变量 假跳 = 函数状态["指令们"].长度
      发射(函数状态, {"op": "JUMP_IF_FALSE", "arg": 0}, 0)
      编译表达式(状态, 函数状态, 节点["right"])
      发射(函数状态, {"op": "NOT"}, 0)
      发射(函数状态, {"op": "NOT"}, 0)
      变量 结束跳 = 函数状态["指令们"].长度
      发射(函数状态, {"op": "JUMP", "arg": 0}, 0)
      函数状态["指令们"][假跳] = {"op": "JUMP_IF_FALSE", "arg": 函数状态["指令们"].长度}
      发射(函数状态, {"op": "LOAD_CONST", "arg": 取常量(状态, 假)}, 0)
      函数状态["指令们"][结束跳] = {"op": "JUMP", "arg": 函数状态["指令们"].长度}
      返回
    }
    如果 节点["op"] 等于 "||" {
      编译表达式(状态, 函数状态, 节点["left"])
      发射(函数状态, {"op": "NOT"}, 0)
      变量 真跳 = 函数状态["指令们"].长度
      发射(函数状态, {"op": "JUMP_IF_FALSE", "arg": 0}, 0)
      编译表达式(状态, 函数状态, 节点["right"])
      发射(函数状态, {"op": "NOT"}, 0)
      发射(函数状态, {"op": "NOT"}, 0)
      变量 结束跳 = 函数状态["指令们"].长度
      发射(函数状态, {"op": "JUMP", "arg": 0}, 0)
      函数状态["指令们"][真跳] = {"op": "JUMP_IF_FALSE", "arg": 函数状态["指令们"].长度}
      发射(函数状态, {"op": "LOAD_CONST", "arg": 取常量(状态, 真)}, 0)
      函数状态["指令们"][结束跳] = {"op": "JUMP", "arg": 函数状态["指令们"].长度}
      返回
    }
    编译表达式(状态, 函数状态, 节点["left"])
    编译表达式(状态, 函数状态, 节点["right"])
    发射(函数状态, {"op": 指令名(节点["op"])}, 0)
    返回
  }
  如果 种类 等于 "call" {
    变量 内建标记 = 取值(节点, "builtin", 空)
    如果 内建标记 等于 "task" 并且 节点["args"].长度 等于 1 {
      变量 内层 = 节点["args"][0]
      如果 内层["expr"] 不等于 "call" {
        打印("字节码：任务 的参数要是一个函数调用")
        返回
      }
      变量 内层实参们 = 内层["args"]
      循环 实参 在 内层实参们 {
        编译表达式(状态, 函数状态, 实参)
      }
      变量 内层内建 = 取值(内层, "builtin", 空)
      如果 内层内建 不等于 空 {
        发射(函数状态, {"op": "TASK", "arg": {"kind": "builtin",
          "name": 取名字(状态, 内层内建), "argc": 内层实参们.长度}}, 0)
        返回
      }
      如果 取值(内层, "ffi", 空) 不等于 空 {
        打印("字节码：任务 里暂不支持 FFI")
        返回
      }
      变量 内层目标 = 取值(内层, "target", 空)
      如果 内层目标 不等于 空 {
        如果 内层目标["expr"] 不等于 "name" {
          打印("字节码：任务 里不支持方法调用")
          返回
        }
        发射(函数状态, {"op": "TASK", "arg": {"kind": "module",
          "module": 取名字(状态, 内层目标["name"]),
          "name": 取名字(状态, 内层["name"]),
          "argc": 内层实参们.长度}}, 0)
        返回
      }
      如果 包含(状态["函数名们"], 内层["name"]) {
        发射(函数状态, {"op": "TASK", "arg": {"kind": "user",
          "name": 取名字(状态, 内层["name"]), "argc": 内层实参们.长度}}, 0)
        返回
      }
      打印("字节码：任务 的目标不在 AGB 范围", 内层["name"])
      返回
    }
    变量 实参们 = 节点["args"]
    循环 实参 在 实参们 {
      编译表达式(状态, 函数状态, 实参)
    }
    变量 ffi库 = 取值(节点, "ffi", 空)
    如果 ffi库 不等于 空 {
      发射(函数状态, {"op": "CALL_FFI",
        "arg": {"lib": 取名字(状态, ffi库),
                "name": 取名字(状态, 节点["name"]),
                "argc": 实参们.长度}}, 0)
      返回
    }
    变量 原名 = 节点["name"]
    如果 包含(状态["类型名们"], 原名) {
      变量 字段名们 = []
      循环 实参 在 实参们 {
        字段名们 = 追加(字段名们, 取名字(状态, 实参["name"]))
      }
      发射(函数状态, {"op": "STRUCT_NEW", "arg": {"type": 取名字(状态, 原名),
        "fields": 字段名们, "argc": 实参们.长度}}, 0)
      返回
    }
    变量 内建名 = 取值(节点, "builtin", 空)
    // 用户自己的函数优先于同名内建（语言口径），所以先看函数名表，再决定走内建。
    如果 包含(状态["函数名们"], 原名) {
      变量 名槽 = 取名字(状态, 原名)
      发射(函数状态, {"op": "CALL_USER", "arg": {"name": 名槽, "argc": 实参们.长度}}, 0)
    } 否则 如果 内建名 不等于 空 {
      变量 名槽 = 取名字(状态, 内建名)
      发射(函数状态, {"op": "CALL_BUILTIN", "arg": {"name": 名槽, "argc": 实参们.长度}}, 0)
    } 否则 {
      变量 名槽 = 取名字(状态, 内建规范名(原名))
      发射(函数状态, {"op": "CALL_BUILTIN", "arg": {"name": 名槽, "argc": 实参们.长度}}, 0)
    }
    返回
  }
  如果 种类 等于 "match" {
    变量 临时名 = "__match" + 转文本(状态["匹配计数"])
    状态["匹配计数"] = 状态["匹配计数"] + 1
    编译表达式(状态, 函数状态, 节点["subject"])
    发射(函数状态, {"op": "STORE_NAME", "arg": 取名字(状态, 临时名)}, 0)
    变量 结束位置们 = []
    循环 分支 在 节点["arms"] {
      变量 模式 = 分支["pattern"]
      变量 通配 = 假
      如果 模式["expr"] 等于 "name" {
        如果 模式["name"] 等于 "_" {
          通配 = 真
        }
      }
      变量 列表模式 = 假
      如果 模式["expr"] 等于 "list_pattern" {
        列表模式 = 真
      }
      变量 映射模式 = 假
      如果 模式["expr"] 等于 "map_pattern" {
        映射模式 = 真
      }
      变量 检查位置们 = []
      如果 映射模式 {
        检查位置们 = 编译映射模式检查(状态, 函数状态, 临时名,
          模式["entries"], 检查位置们)
      } 否则 如果 列表模式 {
        检查位置们 = 编译列表模式检查(状态, 函数状态, 临时名,
          模式["items"], 检查位置们)
      } 否则 如果 通配 等于 假 {
        发射(函数状态, {"op": "LOAD_NAME", "arg": 取名字(状态, 临时名)}, 0)
        编译表达式(状态, 函数状态, 模式)
        发射(函数状态, {"op": "EQ"}, 0)
        变量 值检查 = 函数状态["指令们"].长度
        发射(函数状态, {"op": "JUMP_IF_FALSE", "arg": 0}, 0)
        检查位置们 = 追加(检查位置们, 值检查)
      }
      如果 包含(分支, "bind") {
        如果 分支["bind"] 不等于 "" {
          发射(函数状态, {"op": "LOAD_NAME", "arg": 取名字(状态, 临时名)}, 0)
          发射(函数状态, {"op": "STORE_NAME",
            "arg": 取名字(状态, 分支["bind"])}, 0)
        }
      }
      变量 守卫位置 = -1
      如果 包含(分支, "guard") {
        编译表达式(状态, 函数状态, 分支["guard"])
        守卫位置 = 函数状态["指令们"].长度
        发射(函数状态, {"op": "JUMP_IF_FALSE", "arg": 0}, 0)
      }
      编译表达式(状态, 函数状态, 分支["body"])
      变量 结束位置 = 函数状态["指令们"].长度
      发射(函数状态, {"op": "JUMP", "arg": 0}, 0)
      结束位置们 = 追加(结束位置们, 结束位置)
      如果 守卫位置 大于等于 0 {
        函数状态["指令们"][守卫位置] = {"op": "JUMP_IF_FALSE",
          "arg": 函数状态["指令们"].长度}
      }
      循环 检查位置 在 检查位置们 {
        函数状态["指令们"][检查位置] = {"op": "JUMP_IF_FALSE",
          "arg": 函数状态["指令们"].长度}
      }
    }
    发射(函数状态, {"op": "LOAD_CONST", "arg": 0}, 0)
    循环 结束位置 在 结束位置们 {
      函数状态["指令们"][结束位置] = {"op": "JUMP",
        "arg": 函数状态["指令们"].长度}
    }
    返回
  }
  打印("字节码：暂不支持的表达式", 种类)
}

函数 编译语句们(状态: 映射表, 函数状态: 映射表, 语句们: 列表) {
  循环 语句 在 语句们 {
    编译语句(状态, 函数状态, 语句)
  }
}

函数 循环顶(函数状态: 映射表) -> 映射表 {
  返回 函数状态["循环们"][函数状态["循环们"].长度 - 1]
}

函数 记中断(函数状态: 映射表) {
  变量 环 = 循环顶(函数状态)
  变量 位置 = 函数状态["指令们"].长度
  发射(函数状态, {"op": "JUMP", "arg": 0}, 0)
  环["中断们"] = 追加(环["中断们"], 位置)
}

函数 记继续(函数状态: 映射表) {
  变量 环 = 循环顶(函数状态)
  变量 位置 = 函数状态["指令们"].长度
  发射(函数状态, {"op": "JUMP", "arg": 0}, 0)
  环["继续们"] = 追加(环["继续们"], 位置)
}

函数 补跳(函数状态: 映射表, 位置们: 列表, 目标: 整数) {
  循环 位置 在 位置们 {
    函数状态["指令们"][位置] = {"op": "JUMP", "arg": 目标}
  }
}

函数 编译单段最后(状态: 映射表, 函数状态: 映射表, 块: 列表) {
  变量 保存 = 函数状态["最终块们"]
  如果 保存.长度 大于 0 {
    函数状态["最终块们"] = 切片(保存, 0, 保存.长度 - 1)
  }
  编译语句们(状态, 函数状态, 块)
  函数状态["最终块们"] = 保存
}

函数 补跑最终块们(状态: 映射表, 函数状态: 映射表) {
  变量 下标 = 函数状态["最终块们"].长度 - 1
  当 下标 大于等于 0 {
    变量 块 = 函数状态["最终块们"][下标]
    编译单段最后(状态, 函数状态, 块)
    下标 = 下标 - 1
  }
}

函数 编译列表模式检查(状态: 映射表, 函数状态: 映射表, 容器名: 文本,
                        项们: 列表, 检查位置们: 列表) -> 列表 {
  发射(函数状态, {"op": "LOAD_NAME", "arg": 取名字(状态, 容器名)}, 0)
  发射(函数状态, {"op": "MATCH_LIST", "arg": 项们.长度}, 0)
  变量 列表检查 = 函数状态["指令们"].长度
  发射(函数状态, {"op": "JUMP_IF_FALSE", "arg": 0}, 0)
  检查位置们 = 追加(检查位置们, 列表检查)
  变量 序号 = 0
  循环 项 在 项们 {
    如果 项["kind"] 等于 "bind" {
      发射(函数状态, {"op": "LOAD_NAME", "arg": 取名字(状态, 容器名)}, 0)
      发射(函数状态, {"op": "LOAD_CONST", "arg": 取常量(状态, 序号)}, 0)
      发射(函数状态, {"op": "INDEX"}, 0)
      发射(函数状态, {"op": "STORE_NAME", "arg": 取名字(状态, 项["name"])}, 0)
    }
    如果 项["kind"] 等于 "literal" {
      发射(函数状态, {"op": "LOAD_NAME", "arg": 取名字(状态, 容器名)}, 0)
      发射(函数状态, {"op": "LOAD_CONST", "arg": 取常量(状态, 序号)}, 0)
      发射(函数状态, {"op": "INDEX"}, 0)
      编译表达式(状态, 函数状态, 项["value"])
      发射(函数状态, {"op": "EQ"}, 0)
      变量 字面检查 = 函数状态["指令们"].长度
      发射(函数状态, {"op": "JUMP_IF_FALSE", "arg": 0}, 0)
      检查位置们 = 追加(检查位置们, 字面检查)
    }
    如果 项["kind"] 等于 "list" {
      变量 内层名 = "__match" + 转文本(状态["匹配计数"])
      状态["匹配计数"] = 状态["匹配计数"] + 1
      发射(函数状态, {"op": "LOAD_NAME", "arg": 取名字(状态, 容器名)}, 0)
      发射(函数状态, {"op": "LOAD_CONST", "arg": 取常量(状态, 序号)}, 0)
      发射(函数状态, {"op": "INDEX"}, 0)
      发射(函数状态, {"op": "STORE_NAME", "arg": 取名字(状态, 内层名)}, 0)
      检查位置们 = 编译列表模式检查(状态, 函数状态, 内层名,
        项["pattern"]["items"], 检查位置们)
    }
    序号 = 序号 + 1
  }
  返回 检查位置们
}

函数 编译映射模式检查(状态: 映射表, 函数状态: 映射表, 容器名: 文本,
                          条目们: 列表, 检查位置们: 列表) -> 列表 {
  循环 条目 在 条目们 {
    变量 键 = 条目["key"]
    发射(函数状态, {"op": "LOAD_NAME", "arg": 取名字(状态, 容器名)}, 0)
    编译表达式(状态, 函数状态, 键)
    发射(函数状态, {"op": "CALL_BUILTIN",
      "arg": {"name": 取名字(状态, "contains"), "argc": 2}}, 0)
    变量 键检查 = 函数状态["指令们"].长度
    发射(函数状态, {"op": "JUMP_IF_FALSE", "arg": 0}, 0)
    检查位置们 = 追加(检查位置们, 键检查)
    变量 值项 = 条目["value"]
    如果 值项["kind"] 等于 "literal" {
      发射(函数状态, {"op": "LOAD_NAME", "arg": 取名字(状态, 容器名)}, 0)
      编译表达式(状态, 函数状态, 键)
      发射(函数状态, {"op": "INDEX"}, 0)
      编译表达式(状态, 函数状态, 值项["value"])
      发射(函数状态, {"op": "EQ"}, 0)
      变量 值检查 = 函数状态["指令们"].长度
      发射(函数状态, {"op": "JUMP_IF_FALSE", "arg": 0}, 0)
      检查位置们 = 追加(检查位置们, 值检查)
    }
    如果 值项["kind"] 等于 "bind" {
      发射(函数状态, {"op": "LOAD_NAME", "arg": 取名字(状态, 容器名)}, 0)
      编译表达式(状态, 函数状态, 键)
      发射(函数状态, {"op": "INDEX"}, 0)
      发射(函数状态, {"op": "STORE_NAME", "arg": 取名字(状态, 值项["name"])}, 0)
    }
    如果 值项["kind"] 等于 "list" 或 值项["kind"] 等于 "map" {
      变量 内层名 = "__match" + 转文本(状态["匹配计数"])
      状态["匹配计数"] = 状态["匹配计数"] + 1
      发射(函数状态, {"op": "LOAD_NAME", "arg": 取名字(状态, 容器名)}, 0)
      编译表达式(状态, 函数状态, 键)
      发射(函数状态, {"op": "INDEX"}, 0)
      发射(函数状态, {"op": "STORE_NAME", "arg": 取名字(状态, 内层名)}, 0)
      如果 值项["kind"] 等于 "list" {
        检查位置们 = 编译列表模式检查(状态, 函数状态, 内层名,
          值项["pattern"]["items"], 检查位置们)
      } 否则 {
        检查位置们 = 编译映射模式检查(状态, 函数状态, 内层名,
          值项["pattern"]["entries"], 检查位置们)
      }
    }
  }
  返回 检查位置们
}

函数 编译语句(状态: 映射表, 函数状态: 映射表, 节点: 映射表) {
  变量 种类 = 节点["stmt"]
  如果 种类 等于 "let" {
    编译表达式(状态, 函数状态, 节点["value"])
    发射(函数状态, {"op": "STORE_NAME", "arg": 取名字(状态, 节点["name"])}, 0)
    函数状态["局部们"] = 追加(函数状态["局部们"], 节点["name"])
    返回
  }
  如果 种类 等于 "assign_multi" {
    // let_multi 解包：求值一次 → UNPACK n → 逆序 STORE_NAME（对齐种子 bytecode.py）。
    编译表达式(状态, 函数状态, 节点["value"])
    发射(函数状态, {"op": "UNPACK", "arg": 节点["targets"].长度}, 0)
    循环 目标项 在 反转(节点["targets"]) {
      发射(函数状态, {"op": "STORE_NAME", "arg": 取名字(状态, 目标项["name"])}, 0)
      函数状态["局部们"] = 追加(函数状态["局部们"], 目标项["name"])
    }
    返回
  }
  如果 种类 等于 "assign" {
    变量 目标 = 节点["target"]
    如果 目标["expr"] 等于 "name" {
      编译表达式(状态, 函数状态, 节点["value"])
      发射(函数状态, {"op": "STORE_NAME", "arg": 取名字(状态, 目标["name"])}, 0)
      返回
    }
    如果 目标["expr"] 等于 "index" {
      编译表达式(状态, 函数状态, 目标["target"])
      编译表达式(状态, 函数状态, 目标["index"])
      编译表达式(状态, 函数状态, 节点["value"])
      发射(函数状态, {"op": "STORE_INDEX"}, 0)
      返回
    }
    打印("字节码：暂不支持这种赋值目标", 目标["expr"])
    返回
  }
  如果 种类 等于 "aug_assign" {
    变量 目标 = 节点["target"]
    如果 目标["expr"] 不等于 "name" {
      打印("字节码：暂不支持这种增广赋值目标", 目标["expr"])
      返回
    }
    发射(函数状态, {"op": "LOAD_NAME", "arg": 取名字(状态, 目标["name"])}, 0)
    编译表达式(状态, 函数状态, 节点["value"])
    发射(函数状态, {"op": 指令名(节点["op"])}, 0)
    发射(函数状态, {"op": "STORE_NAME", "arg": 取名字(状态, 目标["name"])}, 0)
    返回
  }
  如果 种类 等于 "expr" {
    编译表达式(状态, 函数状态, 节点["value"])
    发射(函数状态, {"op": "POP"}, 0)
    返回
  }
  如果 种类 等于 "return" {
    编译表达式(状态, 函数状态, 节点["value"])
    补跑最终块们(状态, 函数状态)
    发射(函数状态, {"op": "RETURN"}, 0)
    返回
  }
  如果 种类 等于 "if" {
    编译表达式(状态, 函数状态, 节点["cond"])
    变量 假跳 = 函数状态["指令们"].长度
    发射(函数状态, {"op": "JUMP_IF_FALSE", "arg": 0}, 0)
    编译语句们(状态, 函数状态, 节点["then"])
    变量 否则们 = 节点["else"]
    如果 否则们.长度 大于 0 {
      变量 结束跳 = 函数状态["指令们"].长度
      发射(函数状态, {"op": "JUMP", "arg": 0}, 0)
      函数状态["指令们"][假跳] = {"op": "JUMP_IF_FALSE", "arg": 函数状态["指令们"].长度}
      编译语句们(状态, 函数状态, 否则们)
      函数状态["指令们"][结束跳] = {"op": "JUMP", "arg": 函数状态["指令们"].长度}
    } 否则 {
      函数状态["指令们"][假跳] = {"op": "JUMP_IF_FALSE", "arg": 函数状态["指令们"].长度}
    }
    返回
  }
  如果 种类 等于 "while" {
    变量 开始 = 函数状态["指令们"].长度
    编译表达式(状态, 函数状态, 节点["cond"])
    变量 假跳 = 函数状态["指令们"].长度
    发射(函数状态, {"op": "JUMP_IF_FALSE", "arg": 0}, 0)
    函数状态["循环们"] = 追加(函数状态["循环们"],
      {"类型": "while", "开始": 开始, "中断们": [], "继续们": []})
    编译语句们(状态, 函数状态, 节点["body"])
    变量 环 = 循环顶(函数状态)
    发射(函数状态, {"op": "JUMP", "arg": 开始}, 0)
    变量 结束 = 函数状态["指令们"].长度
    函数状态["指令们"][假跳] = {"op": "JUMP_IF_FALSE", "arg": 结束}
    补跳(函数状态, 环["中断们"], 结束)
    补跳(函数状态, 环["继续们"], 开始)
    函数状态["循环们"] = 弹出(函数状态["循环们"])[1]
    返回
  }
  如果 种类 等于 "for" {
    编译表达式(状态, 函数状态, 节点["iter"])
    发射(函数状态, {"op": "GET_ITER"}, 0)
    变量 开始 = 函数状态["指令们"].长度
    变量 结束跳 = 函数状态["指令们"].长度
    发射(函数状态, {"op": "ITER_NEXT", "arg": 0}, 0)
    发射(函数状态, {"op": "STORE_NAME", "arg": 取名字(状态, 节点["item"])}, 0)
    函数状态["局部们"] = 追加(函数状态["局部们"], 节点["item"])
    函数状态["循环们"] = 追加(函数状态["循环们"],
      {"类型": "for", "开始": 开始, "中断们": [], "继续们": []})
    编译语句们(状态, 函数状态, 节点["body"])
    变量 环 = 循环顶(函数状态)
    发射(函数状态, {"op": "JUMP", "arg": 开始}, 0)
    变量 结束 = 函数状态["指令们"].长度
    函数状态["指令们"][结束跳] = {"op": "ITER_NEXT", "arg": 结束}
    补跳(函数状态, 环["中断们"], 结束)
    补跳(函数状态, 环["继续们"], 开始)
    函数状态["循环们"] = 弹出(函数状态["循环们"])[1]
    返回
  }
  如果 种类 等于 "break" {
    补跑最终块们(状态, 函数状态)
    变量 环 = 循环顶(函数状态)
    如果 环["类型"] 等于 "for" {
      发射(函数状态, {"op": "POP_ITER"}, 0)
    }
    记中断(函数状态)
    返回
  }
  如果 种类 等于 "continue" {
    补跑最终块们(状态, 函数状态)
    记继续(函数状态)
    返回
  }
  如果 种类 等于 "with" {
    编译表达式(状态, 函数状态, 节点["expr"])
    发射(函数状态, {"op": "WITH_ENTER"}, 0)
    如果 节点["name"] 不等于 "" {
      发射(函数状态, {"op": "STORE_NAME", "arg": 取名字(状态, 节点["name"])}, 0)
      函数状态["局部们"] = 追加(函数状态["局部们"], 节点["name"])
    }
    编译语句们(状态, 函数状态, 节点["body"])
    返回
  }
  如果 种类 等于 "match" {
    变量 临时名 = "__match" + 转文本(状态["匹配计数"])
    状态["匹配计数"] = 状态["匹配计数"] + 1
    编译表达式(状态, 函数状态, 节点["subject"])
    发射(函数状态, {"op": "STORE_NAME", "arg": 取名字(状态, 临时名)}, 0)
    变量 结束位置们 = []
    循环 分支 在 节点["arms"] {
      变量 模式 = 分支["pattern"]
      变量 通配 = 假
      如果 模式["expr"] 等于 "name" {
        如果 模式["name"] 等于 "_" {
          通配 = 真
        }
      }
      变量 列表模式 = 假
      如果 模式["expr"] 等于 "list_pattern" {
        列表模式 = 真
      }
      变量 映射模式 = 假
      如果 模式["expr"] 等于 "map_pattern" {
        映射模式 = 真
      }
      变量 跳过位置 = -1
      变量 检查位置们 = []
      如果 映射模式 {
        检查位置们 = 编译映射模式检查(状态, 函数状态, 临时名,
          模式["entries"], 检查位置们)
      } 否则 如果 列表模式 {
        检查位置们 = 编译列表模式检查(状态, 函数状态, 临时名,
          模式["items"], 检查位置们)
      } 否则 如果 通配 {
        通配 = 真
      } 否则 {
        发射(函数状态, {"op": "LOAD_NAME", "arg": 取名字(状态, 临时名)}, 0)
        编译表达式(状态, 函数状态, 模式)
        发射(函数状态, {"op": "EQ"}, 0)
        跳过位置 = 函数状态["指令们"].长度
        发射(函数状态, {"op": "JUMP_IF_FALSE", "arg": 0}, 0)
      }
      变量 守卫位置 = -1
      如果 包含(分支, "bind") {
        如果 分支["bind"] 不等于 "" {
          发射(函数状态, {"op": "LOAD_NAME", "arg": 取名字(状态, 临时名)}, 0)
          发射(函数状态, {"op": "STORE_NAME",
            "arg": 取名字(状态, 分支["bind"])}, 0)
        }
      }
      如果 包含(分支, "guard") {
        如果 分支["guard"] 不等于 空 {
          编译表达式(状态, 函数状态, 分支["guard"])
          守卫位置 = 函数状态["指令们"].长度
          发射(函数状态, {"op": "JUMP_IF_FALSE", "arg": 0}, 0)
        }
      }
      编译语句们(状态, 函数状态, 分支["body"])
      变量 结束位置 = 函数状态["指令们"].长度
      发射(函数状态, {"op": "JUMP", "arg": 0}, 0)
      结束位置们 = 追加(结束位置们, 结束位置)
      如果 跳过位置 大于等于 0 {
        函数状态["指令们"][跳过位置] = {"op": "JUMP_IF_FALSE",
          "arg": 函数状态["指令们"].长度}
      }
      循环 检查位置 在 检查位置们 {
        函数状态["指令们"][检查位置] = {"op": "JUMP_IF_FALSE",
          "arg": 函数状态["指令们"].长度}
      }
      如果 守卫位置 大于等于 0 {
        函数状态["指令们"][守卫位置] = {"op": "JUMP_IF_FALSE",
          "arg": 函数状态["指令们"].长度}
      }
    }
    变量 结束 = 函数状态["指令们"].长度
    循环 位置 在 结束位置们 {
      函数状态["指令们"][位置] = {"op": "JUMP", "arg": 结束}
    }
    返回
  }
  如果 种类 等于 "on_event" {
    编译表达式(状态, 函数状态, 节点["task"])
    变量 回调名 = 编译回调(状态, 节点)
    发射(函数状态, {"op": "REGISTER_EVENT",
      "arg": {"event": 节点["event"], "name": 取名字(状态, 回调名)}}, 0)
    返回
  }
  如果 种类 等于 "try" {
    变量 最后们 = 取值(节点, "finally", [])
    变量 捕获体 = 取值(节点, "catch", [])
    变量 有捕获 = 捕获体.长度 大于 0
    变量 有最后 = 最后们.长度 大于 0
    如果 有捕获 等于 假 并且 有最后 等于 假 {
      打印("字节码：尝试 既没有捕获也没有最后")
      返回
    }
    变量 外层位置 = -1
    如果 有最后 {
      外层位置 = 函数状态["指令们"].长度
      发射(函数状态, {"op": "TRY_BEGIN", "arg": {"target": 0, "type": ""}}, 0)
    }
    变量 内层位置 = -1
    变量 捕获类型 = 取值(节点, "catch_type", "")
    如果 有捕获 {
      内层位置 = 函数状态["指令们"].长度
      发射(函数状态, {"op": "TRY_BEGIN",
        "arg": {"target": 0, "type": 捕获类型}}, 0)
    }
    如果 有最后 {
      函数状态["最终块们"] = 追加(函数状态["最终块们"], 最后们)
    }
    编译语句们(状态, 函数状态, 节点["body"])
    如果 有最后 {
      函数状态["最终块们"] = 切片(函数状态["最终块们"], 0,
        函数状态["最终块们"].长度 - 1)
    }
    如果 有捕获 {
      发射(函数状态, {"op": "TRY_END"}, 0)
    }
    编译语句们(状态, 函数状态, 取值(节点, "else", []))
    变量 结束跳 = 函数状态["指令们"].长度
    发射(函数状态, {"op": "JUMP", "arg": 0}, 0)
    如果 有捕获 {
      函数状态["指令们"][内层位置] = {"op": "TRY_BEGIN",
        "arg": {"target": 函数状态["指令们"].长度, "type": 捕获类型}}
      如果 取值(节点, "catch_name", "") 不等于 "" {
        发射(函数状态, {"op": "STORE_NAME",
          "arg": 取名字(状态, 节点["catch_name"])}, 0)
        函数状态["局部们"] = 追加(函数状态["局部们"], 节点["catch_name"])
      } 否则 {
        发射(函数状态, {"op": "POP"}, 0)
      }
      如果 有最后 {
        函数状态["最终块们"] = 追加(函数状态["最终块们"], 最后们)
      }
      编译语句们(状态, 函数状态, 捕获体)
      如果 有最后 {
        函数状态["最终块们"] = 切片(函数状态["最终块们"], 0,
          函数状态["最终块们"].长度 - 1)
      }
      函数状态["指令们"][结束跳] = {"op": "JUMP",
        "arg": 函数状态["指令们"].长度}
    }
    如果 有最后 {
      如果 有捕获 等于 假 {
        函数状态["指令们"][结束跳] = {"op": "JUMP",
          "arg": 函数状态["指令们"].长度}
      }
      发射(函数状态, {"op": "TRY_END"}, 0)
      函数状态["最终块们"] = 追加(函数状态["最终块们"], 最后们)
      编译单段最后(状态, 函数状态, 最后们)
      函数状态["最终块们"] = 切片(函数状态["最终块们"], 0,
        函数状态["最终块们"].长度 - 1)
      变量 正常结束跳 = 函数状态["指令们"].长度
      发射(函数状态, {"op": "JUMP", "arg": 0}, 0)
      函数状态["指令们"][外层位置] = {"op": "TRY_BEGIN",
        "arg": {"target": 函数状态["指令们"].长度, "type": ""}}
      函数状态["最终块们"] = 追加(函数状态["最终块们"], 最后们)
      编译单段最后(状态, 函数状态, 最后们)
      函数状态["最终块们"] = 切片(函数状态["最终块们"], 0,
        函数状态["最终块们"].长度 - 1)
      发射(函数状态, {"op": "RETHROW"}, 0)
      函数状态["指令们"][正常结束跳] = {"op": "JUMP",
        "arg": 函数状态["指令们"].长度}
    }
    返回
  }
  打印("字节码：暂不支持的语句", 种类)
}

函数 参数名们(参数们: 列表) -> 列表 {
  变量 名单 = []
  循环 参数 在 参数们 {
    名单 = 追加(名单, 参数["name"])
  }
  返回 名单
}

函数 编译函数(状态: 映射表, 节点: 映射表) -> 映射表 {
  变量 函数状态 = {"指令们": [], "行号们": [], "循环们": [], "最终块们": [],
    "局部们": 参数名们(节点["params"])}
  循环 语句 在 节点["body"] {
    编译语句(状态, 函数状态, 语句)
  }
  发射(函数状态, {"op": "LOAD_CONST", "arg": 0}, 0)
  发射(函数状态, {"op": "RETURN"}, 0)
  返回 {"name": 节点["name"], "params": 参数名们(节点["params"]),
        "effects": 节点["effects"], "code": 函数状态["指令们"], "lines": 函数状态["行号们"]}
}

函数 编译回调(状态: 映射表, 节点: 映射表) -> 文本 {
  变量 计数 = 状态["回调计数"]
  状态["回调计数"] = 计数 + 1
  变量 回调名 = "__回调" + 转文本(计数)
  变量 回调节点 = {"name": 回调名,
    "params": [{"name": 节点["param"]}],
    "effects": [], "body": 节点["body"]}
  变量 函数映射 = 编译函数(状态, 回调节点)
  状态["额外函数们"] = 追加(状态["额外函数们"], 函数映射)
  返回 回调名
}

导出 函数 编译程序(ir映射: 映射表) -> 映射表 {
  变量 状态 = {"常量们": [空], "名字们": [], "函数名们": [], "类型名们": [],
    "额外函数们": [], "回调计数": 0, "匹配计数": 0}
  变量 模块信息 = ir映射["program"]["modules"][0]
  变量 类型们 = []
  循环 类型项 在 模块信息["types"] {
    变量 字段名们 = []
    循环 字段 在 类型项["fields"] {
      字段名们 = 追加(字段名们, 字段["name"])
    }
    状态["类型名们"] = 追加(状态["类型名们"], 类型项["name"])
    类型们 = 追加(类型们, {"name": 类型项["name"], "fields": 字段名们})
  }
  循环 节点 在 模块信息["functions"] {
    状态["函数名们"] = 追加(状态["函数名们"], 节点["name"])
  }
  变量 函数们 = []
  循环 节点 在 模块信息["functions"] {
    函数们 = 追加(函数们, 编译函数(状态, 节点))
  }
  变量 额外下标 = 0
  当 额外下标 小于 状态["额外函数们"].长度 {
    函数们 = 追加(函数们, 状态["额外函数们"][额外下标])
    额外下标 = 额外下标 + 1
  }
  // 模块级常量也要进 <init>：VM 的模块全局表就是 init 的 locals。
  // 之前这里漏了 consts，导致常量在 VM 里「名字未定义」。
  变量 初始化状态 = {"指令们": [], "行号们": [], "循环们": [], "最终块们": [],
    "局部们": []}
  循环 常量项 在 取值(模块信息, "consts", []) {
    编译表达式(状态, 初始化状态, 常量项["value"])
    发射(初始化状态, {"op": "STORE_NAME", "arg": 取名字(状态, 常量项["name"])}, 1)
  }
  发射(初始化状态, {"op": "LOAD_CONST", "arg": 0}, 1)
  发射(初始化状态, {"op": "RETURN"}, 1)
  返回 {"format": "AGB", "version": 0, "lang": ir映射["lang"], "module": 模块信息["name"],
        "entry": ir映射["program"]["entry"], "consts": 状态["常量们"], "names": 状态["名字们"],
        "types": 类型们,
        "init": {"name": "<init>", "params": [], "effects": [],
                 "code": 初始化状态["指令们"],
                 "lines": 初始化状态["行号们"]},
        "functions": 函数们}
}

函数 主入口() 效应 读写 {
  变量 源码 = 取到(读文件("tests/golden/full_zh.agl"))
  变量 程序 = 语法分析器.解析程序(词法器.词法分析(源码))
  变量 ir数据 = 中间表示.转换程序(程序, "full_zh", "zh")
  变量 agb = 编译程序(ir数据)
  变量 json文本 = 取到(生成JSON(agb))
  变量 临时根 = 环境变量("TEMP")
  如果 临时根 等于 空 {
    临时根 = "."
  }
  如果 临时根 等于 "" {
    临时根 = "."
  }
  变量 产物目录 = 临时根 + "/agl_agb"
  建文件夹(产物目录)
  取到(写文件(产物目录 + "/selfhost_full.agb", json文本))
  打印("字节码：已产出 selfhost_full.agb，函数", agb["functions"].长度,
        "指令", agb["functions"][0]["code"].长度)
}
