#语言=中文
// 自举：AGL 中间表示 → AGB 字节码。
// 输入是 `中间表示.agl` 产出的 IR（不是 Python 的 IR），输出可被默认 VM 执行的 .agb。
// 覆盖 full_zh 用到的节点：函数 / 参数 / 变量 / 返回 / 如果-否则 / 二元 / 调用 / 字面量。
模块 字节码
导入 词法器
导入 语法分析器
导入 中间表示

函数 发射(函数状态: 映射表, 指令: 映射表, 行号: 整数) {
  函数状态["指令们"] = 追加(函数状态["指令们"], 指令)
  函数状态["行号们"] = 追加(函数状态["行号们"], 行号)
}

函数 取常量(状态: 映射表, 值: 任意) -> 整数 {
  变量 常量们 = 状态["常量们"]
  变量 位置 = 常量们.长度
  状态["常量们"] = 追加(常量们, 值)
  返回 位置
}

函数 取名字(状态: 映射表, 名: 文本) -> 整数 {
  变量 名字们 = 状态["名字们"]
  变量 位置 = 名字们.长度
  状态["名字们"] = 追加(名字们, 名)
  返回 位置
}

函数 指令名(算子: 文本) -> 文本 {
  如果 算子 等于 "+" {
    返回 "ADD"
  }
  如果 算子 等于 "-" {
    返回 "SUB"
  }
  如果 算子 等于 "*" {
    返回 "MUL"
  }
  如果 算子 等于 "/" {
    返回 "DIV"
  }
  如果 算子 等于 "%" {
    返回 "MOD"
  }
  如果 算子 等于 ">" {
    返回 "GT"
  }
  如果 算子 等于 "<" {
    返回 "LT"
  }
  如果 算子 等于 ">=" {
    返回 "GE"
  }
  如果 算子 等于 "<=" {
    返回 "LE"
  }
  如果 算子 等于 "==" {
    返回 "EQ"
  }
  如果 算子 等于 "!=" {
    返回 "NE"
  }
  如果 算子 等于 "&&" {
    返回 "AND"
  }
  如果 算子 等于 "||" {
    返回 "OR"
  }
  打印("字节码：未知运算符", 算子)
  返回 "ADD"
}

