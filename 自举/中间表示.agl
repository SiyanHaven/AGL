#语言=中文
// 自举 B4a：AGL 语法树 → AGL 中间表示（IR）。
// 目标不是“能跑”，而是“和 Python 编译器产出的 IR 在结构字段上对得上”。
// 先覆盖 hello_zh / full_zh 用到的节点：函数、参数、变量、返回、如果、二元、调用、字面量。
模块 中间表示
导入 词法器
导入 语法分析器

函数 转换类型(型名: 文本) -> 映射表 {
  如果 型名 等于 "整数" {
    返回 {"type": "Int"}
  }
  如果 型名 等于 "文本" {
    返回 {"type": "String"}
  }
  如果 型名 等于 "布尔" {
    返回 {"type": "Bool"}
  }
  如果 型名 等于 "浮数" {
    返回 {"type": "Float"}
  }
  如果 型名 等于 "列表" {
    返回 {"type": "List"}
  }
  如果 型名 等于 "映射表" {
    返回 {"type": "Map"}
  }
  如果 型名 等于 "空" {
    返回 {"type": "Null"}
  }
  返回 {"type": "Null"}
}

函数 转换算子(算子: 文本) -> 文本 {
  如果 算子 等于 "+=" {
    返回 "+"
  }
  如果 算子 等于 "-=" {
    返回 "-"
  }
  如果 算子 等于 "*=" {
    返回 "*"
  }
  如果 算子 等于 "/=" {
    返回 "/"
  }
  如果 算子 等于 "%=" {
    返回 "%"
  }
  如果 算子 等于 "大于" {
    返回 ">"
  }
  如果 算子 等于 "小于" {
    返回 "<"
  }
  如果 算子 等于 "大于等于" {
    返回 ">="
  }
  如果 算子 等于 "小于等于" {
    返回 "<="
  }
  如果 算子 等于 "等于" {
    返回 "=="
  }
  如果 算子 等于 "不等于" {
    返回 "!="
  }
  如果 算子 等于 "并且" {
    返回 "&&"
  }
  如果 算子 等于 "或" {
    返回 "||"
  }
  返回 算子
}

函数 转换表达式们(节点们: 列表) -> 列表 {
  变量 名单 = []
  循环 节点 在 节点们 {
    名单 = 追加(名单, 转换表达式(节点))
  }
  返回 名单
}

函数 文本值(原文: 文本) -> 文本 {
  变量 内容 = 原文
  如果 内容.长度 大于等于 2 {
    内容 = 切片(内容, 1, 内容.长度 - 1)
  }
  内容 = 替换(内容, "\\\"", "\"", -1)
  内容 = 替换(内容, "\\\\", "\\", -1)
  返回 内容
}

函数 转换匹配模式(模式: 映射表) -> 映射表 {
  如果 模式["种类"] 等于 "通配" {
    返回 {"expr": "name", "name": "_"}
  }
  如果 模式["种类"] 等于 "字面量" {
    返回 转换表达式(模式["值"])
  }
  如果 模式["种类"] 等于 "列表模式" {
    返回 转换列表模式(模式)
  }
  如果 模式["种类"] 等于 "映射模式" {
    返回 转换映射模式(模式)
  }
  返回 转换表达式(模式)
}

函数 转换表达式(节点: 映射表) -> 映射表 {
  如果 节点["种类"] 等于 "数字" {
    如果 包含(节点["文本"], ".") 或 包含(节点["文本"], "e") 或 包含(节点["文本"], "E") {
      返回 {"expr": "float", "value": 取到(转浮数(节点["文本"]))}
    }
    返回 {"expr": "int", "value": 取到(转整数(节点["文本"], 0))}
  }
  如果 节点["种类"] 等于 "文本" {
    返回 {"expr": "string", "value": 文本值(节点["文本"])}
  }
  如果 节点["种类"] 等于 "真假" {
    返回 {"expr": "bool", "value": 节点["值"]}
  }
  如果 节点["种类"] 等于 "空" {
    返回 {"expr": "null"}
  }
  如果 节点["种类"] 等于 "命名参数" {
    返回 {"expr": "named", "name": 节点["名字"], "value": 转换表达式(节点["值"])}
  }
  如果 节点["种类"] 等于 "名字" {
    返回 {"expr": "name", "name": 节点["名字"]}
  }
  如果 节点["种类"] 等于 "等待" {
    返回 {"expr": "await", "value": 转换表达式(节点["值"])}
  }
  如果 节点["种类"] 等于 "列表" {
    返回 {"expr": "list", "items": 转换表达式们(节点["元素"])}
  }
  如果 节点["种类"] 等于 "集合" {
    返回 {"expr": "set", "items": 转换表达式们(节点["元素"])}
  }
  如果 节点["种类"] 等于 "映射" {
    变量 对们 = []
    循环 一对 在 节点["对"] {
      对们 = 追加(对们, {"key": 转换表达式(一对[0]), "value": 转换表达式(一对[1])})
    }
    返回 {"expr": "map", "entries": 对们}
  }
  如果 节点["种类"] 等于 "匹配表达式" {
    变量 分支们 = []
    循环 分支 在 节点["分支"] {
      变量 项 = {"pattern": 转换匹配模式(分支["模式"]),
                 "body": 转换表达式(分支["体"])}
      如果 分支["绑定"] 不等于 "" {
        项["bind"] = 分支["绑定"]
      }
      如果 分支["守卫"] 不等于 空 {
        项["guard"] = 转换表达式(分支["守卫"])
      }
      分支们 = 追加(分支们, 项)
    }
    返回 {"expr": "match", "subject": 转换表达式(节点["主体"]),
             "arms": 分支们}
  }
  如果 节点["种类"] 等于 "下标" {
    返回 {"expr": "index", "target": 转换表达式(节点["目标"]),
          "index": 转换表达式(节点["下标"])}
  }
  如果 节点["种类"] 等于 "成员" {
    返回 {"expr": "member", "target": 转换表达式(节点["对象"]), "field": 节点["名字"]}
  }
  如果 节点["种类"] 等于 "一元" {
    变量 算子 = 节点["算子"]
    如果 算子 等于 "非" {
      算子 = "!"
    }
    返回 {"expr": "unop", "op": 算子, "operand": 转换表达式(节点["操作数"])}
  }
  如果 节点["种类"] 等于 "二元" {
    返回 {"expr": "binop", "op": 转换算子(节点["算子"]),
          "left": 转换表达式(节点["左"]), "right": 转换表达式(节点["右"])}
  }
  如果 节点["种类"] 等于 "调用" {
    变量 目标 = 节点["目标"]
    变量 实参们 = []
    循环 实参 在 节点["参数"] {
      实参们 = 追加(实参们, 转换表达式(实参))
    }
    如果 目标["种类"] 等于 "名字" 并且 目标["名字"] 等于 "打印" {
      返回 {"expr": "call", "name": "print", "args": 实参们, "builtin": "print"}
    }
    如果 目标["种类"] 等于 "名字" 并且 (目标["名字"] 等于 "任务" 或 目标["名字"] 等于 "task") 并且 实参们.长度 等于 1 {
      返回 {"expr": "call", "name": 目标["名字"], "args": 实参们, "builtin": "task"}
    }
    如果 目标["种类"] 等于 "成员" 并且 取值(目标, "外部", 空) 不等于 空 {
      返回 {"expr": "call", "name": 目标["名字"], "args": 实参们,
            "ffi": 目标["外部"]}
    }
    // 模块扁平化后，`词法器.词法分析(...)` 就是全局函数 `词法分析(...)`。
    如果 目标["种类"] 等于 "成员" 并且 目标["对象"]["种类"] 等于 "名字" {
      返回 {"expr": "call", "name": 目标["名字"], "args": 实参们}
    }
    返回 {"expr": "call", "name": 目标["名字"], "args": 实参们}
  }
  打印("中间表示：暂不支持的表达式", 节点["种类"])
  返回 {"expr": "null"}
}

函数 转换列表模式(模式: 映射表) -> 映射表 {
  变量 项项们 = []
  循环 项 在 模式["项"] {
    如果 项["种类"] 等于 "绑定" {
      项项们 = 追加(项项们, {"kind": "bind", "name": 项["名字"]})
    } 否则 如果 项["种类"] 等于 "通配" {
      项项们 = 追加(项项们, {"kind": "wild", "name": "_"})
    } 否则 如果 项["种类"] 等于 "列表" {
      项项们 = 追加(项项们, {"kind": "list",
        "pattern": 转换列表模式(项["模式"])})
    } 否则 如果 项["种类"] 等于 "映射" {
      项项们 = 追加(项项们, {"kind": "map",
        "pattern": 转换映射模式(项["模式"])})
    } 否则 {
      项项们 = 追加(项项们, {"kind": "literal",
        "value": 转换表达式(项["值"])})
    }
  }
  返回 {"expr": "list_pattern", "items": 项项们}
}

函数 转换映射模式(模式: 映射表) -> 映射表 {
  变量 条目们 = []
  循环 条目 在 模式["条目"] {
    变量 值项 = 空
    如果 条目["值"]["种类"] 等于 "绑定" {
      值项 = {"kind": "bind", "name": 条目["值"]["名字"]}
    } 否则 如果 条目["值"]["种类"] 等于 "通配" {
      值项 = {"kind": "wild", "name": "_"}
    } 否则 如果 条目["值"]["种类"] 等于 "列表" {
      值项 = {"kind": "list", "pattern": 转换列表模式(条目["值"]["模式"])}
    } 否则 如果 条目["值"]["种类"] 等于 "映射" {
      值项 = {"kind": "map", "pattern": 转换映射模式(条目["值"]["模式"])}
    } 否则 {
      值项 = {"kind": "literal", "value": 转换表达式(条目["值"]["值"])}
    }
    条目们 = 追加(条目们, {"key": 转换表达式(条目["键"]), "value": 值项})
  }
  返回 {"expr": "map_pattern", "entries": 条目们}
}

函数 转换语句们(语句们: 列表) -> 列表 {
  变量 名单 = []
  循环 语句 在 语句们 {
    名单 = 追加(名单, 转换语句(语句))
  }
  返回 名单
}

函数 转换语句(节点: 映射表) -> 映射表 {
  如果 节点["种类"] 等于 "表达式" {
    返回 {"stmt": "expr", "value": 转换表达式(节点["值"])}
  }
  如果 节点["种类"] 等于 "变量" {
    返回 {"stmt": "let", "name": 节点["名字"], "mutable": 真,
          "value": 转换表达式(节点["值"])}
  }
  如果 节点["种类"] 等于 "变量解包" {
    // let_multi：变量 甲, 乙 = 值；目标必须是变量名，与种子 assign_multi 同形。
    变量 目标们 = []
    循环 名 在 节点["名字们"] {
      目标们 = 追加(目标们, {"expr": "name", "name": 名})
    }
    返回 {"stmt": "assign_multi", "targets": 目标们,
          "value": 转换表达式(节点["值"])}
  }
  如果 节点["种类"] 等于 "返回" {
    返回 {"stmt": "return", "value": 转换表达式(节点["值"])}
  }
  如果 节点["种类"] 等于 "如果" {
    返回 {"stmt": "if", "cond": 转换表达式(节点["条件"]),
          "then": 转换语句们(节点["那么"]), "else": 转换语句们(节点["否则"])}
  }
  如果 节点["种类"] 等于 "当" {
    返回 {"stmt": "while", "cond": 转换表达式(节点["条件"]),
          "body": 转换语句们(节点["体"])}
  }
  如果 节点["种类"] 等于 "循环每个" {
    返回 {"stmt": "for", "item": 节点["名字"],
          "iter": 转换表达式(节点["集合"]), "body": 转换语句们(节点["体"])}
  }
  如果 节点["种类"] 等于 "赋值" {
    返回 {"stmt": "assign", "target": 转换表达式(节点["目标"]),
          "value": 转换表达式(节点["值"])}
  }
  如果 节点["种类"] 等于 "增加赋值" {
    返回 {"stmt": "aug_assign", "target": 转换表达式(节点["目标"]),
          "op": 转换算子(节点["算子"]), "value": 转换表达式(节点["值"])}
  }
  如果 节点["种类"] 等于 "使用" {
    返回 {"stmt": "with", "expr": 转换表达式(节点["值"]),
          "name": 节点["名字"], "body": 转换语句们(节点["体"])}
  }
  如果 节点["种类"] 等于 "当任务完成" {
    返回 {"stmt": "on_event", "event": "finish",
          "task": 转换表达式(节点["任务"]), "param": 节点["参数名"],
          "param_type": 转换类型(节点["参数类型"]),
          "body": 转换语句们(节点["体"])}
  }
  如果 节点["种类"] 等于 "当任务失败" {
    返回 {"stmt": "on_event", "event": "fail",
          "task": 转换表达式(节点["任务"]), "param": 节点["参数名"],
          "param_type": 转换类型(节点["参数类型"]),
          "body": 转换语句们(节点["体"])}
  }
  如果 节点["种类"] 等于 "尝试" {
    返回 {"stmt": "try", "body": 转换语句们(节点["体"]),
          "catch_name": 节点["捕获名"], "catch_type": 节点["捕获类型"],
          "catch": 转换语句们(节点["捕获"]),
          "else": 转换语句们(节点["否则"]),
          "finally": 转换语句们(节点["最后"])}
  }
  如果 节点["种类"] 等于 "匹配" {
    变量 分支项们 = []
    循环 分支 在 节点["分支们"] {
      变量 模式项 = 空
      如果 分支["模式"]["种类"] 等于 "列表模式" {
        模式项 = 转换列表模式(分支["模式"])
      } 否则 如果 分支["模式"]["种类"] 等于 "映射模式" {
        模式项 = 转换映射模式(分支["模式"])
      } 否则 {
        模式项 = 转换表达式(分支["模式"])
      }
      变量 分支项 = {"pattern": 模式项,
        "body": 转换语句们(分支["体"])}
      如果 分支["守卫"] 不等于 空 {
        分支项["guard"] = 转换表达式(分支["守卫"])
      }
      如果 分支["绑定"] 不等于 "" {
        分支项["bind"] = 分支["绑定"]
      }
      分支项们 = 追加(分支项们, 分支项)
    }
    返回 {"stmt": "match", "subject": 转换表达式(节点["主体"]),
          "arms": 分支项们}
  }
  如果 节点["种类"] 等于 "中断" {
    返回 {"stmt": "break"}
  }
  如果 节点["种类"] 等于 "继续" {
    返回 {"stmt": "continue"}
  }
  打印("中间表示：暂不支持的语句", 节点["种类"])
  返回 {"stmt": "expr", "value": {"expr": "null"}}
}

函数 转换参数们(参数们: 列表) -> 列表 {
  变量 名单 = []
  循环 参数 在 参数们 {
    名单 = 追加(名单, {"name": 参数["名字"], "type": 转换类型(参数["类型"])})
  }
  返回 名单
}

函数 转换效应(效应名: 文本) -> 文本 {
  如果 效应名 等于 "读写" {
    返回 "IO"
  }
  如果 效应名 等于 "网络" {
    返回 "Net"
  }
  如果 效应名 等于 "计时" 或 效应名 等于 "时间" {
    返回 "Time"
  }
  如果 效应名 等于 "外部调用" 或 效应名 等于 "外部" {
    返回 "External"
  }
  如果 效应名 等于 "模型" {
    返回 "model"
  }
  返回 效应名
}

函数 转换效应们(效应名单: 列表) -> 列表 {
  变量 名单 = []
  循环 效应项 在 效应名单 {
    名单 = 追加(名单, 转换效应(效应项))
  }
  返回 名单
}

函数 转换字段们(字段们: 列表) -> 列表 {
  变量 名单 = []
  循环 字段 在 字段们 {
    名单 = 追加(名单, {"name": 字段["名字"], "type": 转换类型(字段["类型"])})
  }
  返回 名单
}

函数 转换函数(节点: 映射表) -> 映射表 {
  变量 异步标记 = 假
  如果 取值(节点, "异步", 假) {
    异步标记 = 真
  }
  返回 {"name": 节点["名字"], "params": 转换参数们(节点["参数"]),
        "return": 转换类型(节点["返回"]), "effects": 转换效应们(节点["效应"]),
        "is_async": 异步标记,
        "checks": 转换表达式们(取值(节点, "校验", [])),
        "body": 转换语句们(节点["体"])}
}

导出 函数 转换程序(程序: 列表, 模块名: 文本, 语言: 文本) -> 映射表 {
  变量 函数们 = []
  变量 类型们 = []
  变量 声明们 = []
  变量 常量们 = []
  循环 节点 在 程序 {
    如果 节点["种类"] 等于 "函数" {
      函数们 = 追加(函数们, 转换函数(节点))
    } 否则 如果 节点["种类"] 等于 "类型声明" {
      类型们 = 追加(类型们, {"name": 节点["名字"],
        "fields": 转换字段们(节点["字段"])})
    } 否则 如果 节点["种类"] 等于 "变量" {
      // 自举解析器把顶层常量记成「变量」节点；补回 IR 的 consts，
      // 否则自举产物会漏掉模块常量，VM 里报「名字未定义」。
      常量们 = 追加(常量们, {"name": 节点["名字"],
        "value": 转换表达式(节点["值"])})
    } 否则 如果 节点["种类"] 等于 "声明" {
      // T3：工具/智能体/规则记录进 IR；字节码层忽略，不产生运行期代码。
      声明们 = 追加(声明们, 节点)
    }
  }
  // 中英同构：中文入口是 `主入口`，英文入口是 `main`；两者都在时以中文为准。
  变量 有中文入口 = 假
  变量 有英文入口 = 假
  循环 函数项 在 函数们 {
    如果 函数项["name"] 等于 "主入口" {
      有中文入口 = 真
    }
    如果 函数项["name"] 等于 "main" {
      有英文入口 = 真
    }
  }
  变量 入口 = "主入口"
  如果 有英文入口 并且 非 有中文入口 {
    入口 = "main"
  }
  // T7：库文件（无入口）也编出可运行的 .agb —— 合成空入口，
  // 运行输出为空，与种子 `run` 库文件行为一致（rc=0、无输出）。
  变量 有入口 = 假
  循环 函数项 在 函数们 {
    如果 函数项["name"] 等于 入口 {
      有入口 = 真
    }
  }
  如果 非 有入口 {
    函数们 = 追加(函数们, {"name": 入口, "params": [], "return": {"type": "Null"},
      "effects": [], "is_async": 假, "checks": [], "body": []})
  }
  返回 {"ir_version": "0.2", "lang": 语言,
        "program": {"entry": 入口,
                    "modules": [{"name": 模块名, "imports": [], "exports": [],
                                 "consts": 常量们, "types": 类型们, "functions": 函数们,
                                 "declarations": 声明们}]}}
}

函数 主入口() 效应 读写 {
  变量 源码 = 取到(读文件("tests/golden/full_zh.agl"))
  变量 程序 = 语法分析器.解析程序(词法器.词法分析(源码))
  变量 中间表示 = 转换程序(程序, "full_zh", "zh")
  变量 json文本 = 取到(生成JSON(中间表示))
  变量 临时根 = 环境变量("TEMP")
  如果 临时根 等于 空 {
    临时根 = "."
  }
  如果 临时根 等于 "" {
    临时根 = "."
  }
  变量 产物目录 = 临时根 + "/agl_agb"
  建文件夹(产物目录)
  取到(写文件(产物目录 + "/selfhost_full.ir", json文本))
  打印("中间表示：已产出 selfhost_full.ir，函数", 中间表示["program"]["modules"][0]["functions"].长度)
}
