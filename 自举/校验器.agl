#语言=中文
// 自举侧静态校验第一层：未定义调用检查 + 效应传导检查。
// 错误码对齐种子编译器：AGL-E-0302（未定义）、AGL-E-0402（缺效应声明）。
// 遍历按 IR 形状精确递归（自举/中间表示.agl 的节点目录）；
// FFI 调用（带 ffi 键）与编译器合成调用（带 builtin 键：print/task）跳过，
// 它们分别由种子校验和运行时负责。行号由 IR span 提供。

模块 校验器
导入 内建表

// ── 帮手：安全取键（缺键给默认值）──────────────────────────────────
函数 取值(映射: 映射表, 键: 文本, 默认: 任意) -> 任意 {
  如果 包含(映射, 键) {
    返回 映射[键]
  }
  返回 默认
}

// ── 表达式遍历：登记调用并递归子表达式 ──────────────────────────────
函数 走表达式(节点: 映射表, 函数名单: 列表, 函数效应表: 映射表,
             调用者效应: 列表, 当前函数: 文本, 错误们: 列表) -> 列表 {
  变量 类别 = 取值(节点, "expr", "")
  如果 类别 等于 "call" {
    如果 取值(节点, "builtin", 空) 等于 空 并且 取值(节点, "ffi", 空) 等于 空 {
      错误们 = 记调用(取值(节点, "name", ""), 函数名单, 函数效应表,
                     调用者效应, 当前函数, 错误们)
    }
    错误们 = 走表达式们(取值(节点, "args", []), 函数名单, 函数效应表,
                       调用者效应, 当前函数, 错误们)
    返回 错误们
  }
  如果 类别 等于 "await" {
    返回 走表达式(取值(节点, "value", 空), 函数名单, 函数效应表,
                调用者效应, 当前函数, 错误们)
  }
  如果 类别 等于 "named" {
    返回 走表达式(取值(节点, "value", 空), 函数名单, 函数效应表,
                调用者效应, 当前函数, 错误们)
  }
  如果 类别 等于 "list" 或 类别 等于 "set" {
    返回 走表达式们(取值(节点, "items", []), 函数名单, 函数效应表,
                   调用者效应, 当前函数, 错误们)
  }
  如果 类别 等于 "map" {
    循环 条目 在 取值(节点, "entries", []) {
      错误们 = 走表达式(取值(条目, "key", 空), 函数名单, 函数效应表,
                       调用者效应, 当前函数, 错误们)
      错误们 = 走表达式(取值(条目, "value", 空), 函数名单, 函数效应表,
                       调用者效应, 当前函数, 错误们)
    }
    返回 错误们
  }
  如果 类别 等于 "match" {
    错误们 = 走表达式(取值(节点, "subject", 空), 函数名单, 函数效应表,
                     调用者效应, 当前函数, 错误们)
    循环 臂 在 取值(节点, "arms", []) {
      错误们 = 走表达式(取值(臂, "pattern", 空), 函数名单, 函数效应表,
                       调用者效应, 当前函数, 错误们)
      如果 取值(臂, "guard", 空) 不等于 空 {
        错误们 = 走表达式(取值(臂, "guard", 空), 函数名单, 函数效应表,
                         调用者效应, 当前函数, 错误们)
      }
    }
    返回 错误们
  }
  如果 类别 等于 "list_pattern" {
    循环 项 在 取值(节点, "items", []) {
      如果 取值(项, "value", 空) 不等于 空 {
        错误们 = 走表达式(取值(项, "value", 空), 函数名单, 函数效应表,
                         调用者效应, 当前函数, 错误们)
      }
      如果 取值(项, "pattern", 空) 不等于 空 {
        错误们 = 走表达式(取值(项, "pattern", 空), 函数名单, 函数效应表,
                         调用者效应, 当前函数, 错误们)
      }
    }
    返回 错误们
  }
  如果 类别 等于 "map_pattern" {
    循环 条目 在 取值(节点, "entries", []) {
      错误们 = 走表达式(取值(条目, "key", 空), 函数名单, 函数效应表,
                       调用者效应, 当前函数, 错误们)
      错误们 = 走表达式(取值(条目, "value", 空), 函数名单, 函数效应表,
                       调用者效应, 当前函数, 错误们)
    }
    返回 错误们
  }
  如果 类别 等于 "index" {
    错误们 = 走表达式(取值(节点, "target", 空), 函数名单, 函数效应表,
                     调用者效应, 当前函数, 错误们)
    返回 走表达式(取值(节点, "index", 空), 函数名单, 函数效应表,
                调用者效应, 当前函数, 错误们)
  }
  如果 类别 等于 "member" {
    返回 走表达式(取值(节点, "target", 空), 函数名单, 函数效应表,
                调用者效应, 当前函数, 错误们)
  }
  如果 类别 等于 "unop" {
    返回 走表达式(取值(节点, "operand", 空), 函数名单, 函数效应表,
                调用者效应, 当前函数, 错误们)
  }
  如果 类别 等于 "binop" {
    错误们 = 走表达式(取值(节点, "left", 空), 函数名单, 函数效应表,
                     调用者效应, 当前函数, 错误们)
    返回 走表达式(取值(节点, "right", 空), 函数名单, 函数效应表,
                调用者效应, 当前函数, 错误们)
  }
  返回 错误们
}

// ── 表达式列表遍历 ──────────────────────────────────────────────────
函数 走表达式们(节点们: 列表, 函数名单: 列表, 函数效应表: 映射表,
              调用者效应: 列表, 当前函数: 文本, 错误们: 列表) -> 列表 {
  循环 节点 在 节点们 {
    错误们 = 走表达式(节点, 函数名单, 函数效应表, 调用者效应, 当前函数, 错误们)
  }
  返回 错误们
}

// ── 语句遍历：按 stmt 形状分发，递归子语句体 ────────────────────────
函数 走语句们(语句们: 列表, 函数名单: 列表, 函数效应表: 映射表,
            调用者效应: 列表, 当前函数: 文本, 错误们: 列表) -> 列表 {
  循环 语句 在 语句们 {
    变量 类别 = 取值(语句, "stmt", "")
    如果 类别 等于 "expr" 或 类别 等于 "let" 或 类别 等于 "return" {
      错误们 = 走表达式(取值(语句, "value", 空), 函数名单, 函数效应表,
                       调用者效应, 当前函数, 错误们)
    }
    如果 类别 等于 "assign_multi" 或 类别 等于 "assign" 或 类别 等于 "aug_assign" {
      错误们 = 走表达式(取值(语句, "target", 空), 函数名单, 函数效应表,
                       调用者效应, 当前函数, 错误们)
      错误们 = 走表达式(取值(语句, "value", 空), 函数名单, 函数效应表,
                       调用者效应, 当前函数, 错误们)
    }
    如果 类别 等于 "if" {
      错误们 = 走表达式(取值(语句, "cond", 空), 函数名单, 函数效应表,
                       调用者效应, 当前函数, 错误们)
      错误们 = 走语句们(取值(语句, "then", []), 函数名单, 函数效应表,
                       调用者效应, 当前函数, 错误们)
      错误们 = 走语句们(取值(语句, "else", []), 函数名单, 函数效应表,
                       调用者效应, 当前函数, 错误们)
    }
    如果 类别 等于 "while" {
      错误们 = 走表达式(取值(语句, "cond", 空), 函数名单, 函数效应表,
                       调用者效应, 当前函数, 错误们)
      错误们 = 走语句们(取值(语句, "body", []), 函数名单, 函数效应表,
                       调用者效应, 当前函数, 错误们)
    }
    如果 类别 等于 "for" {
      错误们 = 走表达式(取值(语句, "iter", 空), 函数名单, 函数效应表,
                       调用者效应, 当前函数, 错误们)
      错误们 = 走语句们(取值(语句, "body", []), 函数名单, 函数效应表,
                       调用者效应, 当前函数, 错误们)
    }
    如果 类别 等于 "with" {
      错误们 = 走表达式(取值(语句, "expr", 空), 函数名单, 函数效应表,
                       调用者效应, 当前函数, 错误们)
      错误们 = 走语句们(取值(语句, "body", []), 函数名单, 函数效应表,
                       调用者效应, 当前函数, 错误们)
    }
    如果 类别 等于 "on_event" {
      错误们 = 走表达式(取值(语句, "task", 空), 函数名单, 函数效应表,
                       调用者效应, 当前函数, 错误们)
      错误们 = 走语句们(取值(语句, "body", []), 函数名单, 函数效应表,
                       调用者效应, 当前函数, 错误们)
    }
    如果 类别 等于 "try" {
      错误们 = 走语句们(取值(语句, "body", []), 函数名单, 函数效应表,
                       调用者效应, 当前函数, 错误们)
      错误们 = 走语句们(取值(语句, "catch", []), 函数名单, 函数效应表,
                       调用者效应, 当前函数, 错误们)
      错误们 = 走语句们(取值(语句, "else", []), 函数名单, 函数效应表,
                       调用者效应, 当前函数, 错误们)
      错误们 = 走语句们(取值(语句, "finally", []), 函数名单, 函数效应表,
                       调用者效应, 当前函数, 错误们)
    }
    如果 类别 等于 "match" {
      错误们 = 走表达式(取值(语句, "subject", 空), 函数名单, 函数效应表,
                       调用者效应, 当前函数, 错误们)
      循环 臂 在 取值(语句, "arms", []) {
        错误们 = 走表达式(取值(臂, "pattern", 空), 函数名单, 函数效应表,
                         调用者效应, 当前函数, 错误们)
        如果 取值(臂, "guard", 空) 不等于 空 {
          错误们 = 走表达式(取值(臂, "guard", 空), 函数名单, 函数效应表,
                           调用者效应, 当前函数, 错误们)
        }
        错误们 = 走语句们(取值(臂, "body", []), 函数名单, 函数效应表,
                         调用者效应, 当前函数, 错误们)
      }
    }
  }
  返回 错误们
}

// ── 记录一次调用：未定义检查 + 效应传导检查 ─────────────────────────
函数 记调用(名: 文本, 函数名单: 列表, 函数效应表: 映射表,
          调用者效应: 列表, 当前函数: 文本, 错误们: 列表) -> 列表 {
  如果 名 等于 "" {
    返回 错误们
  }
  如果 名 等于 "入参" {
    // 自举词法器把英文 input 归一成中文关键字「入参」；它不是用户函数。
    如果 非包含(调用者效应, "IO") {
      变量 诊断文本 = "函数 `" + 当前函数 + "` 没有声明效应 `IO`，不能调用内建 `入参`"
      错误们 = 追加(错误们, {"错误码": "AGL-E-0402", "说明": 诊断文本})
    }
    返回 错误们
  }
  如果 包含(取值(函数效应表, "__类型__", []), 名) {
    返回 错误们
  }
  如果 包含(函数名单, 名) {
    循环 声明效应 在 取值(函数效应表, 名, []) {
      如果 非包含(调用者效应, 声明效应) {
        变量 诊断文本 = "函数 `" + 当前函数 + "` 没有声明效应 `" + 声明效应 + "`，不能调用 `" + 名 + "`"
        错误们 = 追加(错误们, {"错误码": "AGL-E-0402", "说明": 诊断文本})
        中断
      }
    }
    返回 错误们
  }
  如果 内建表.是内建(名) {
    变量 内建效应 = 内建表.内建效应(名)
    如果 内建效应 不等于 "" {
      如果 非包含(调用者效应, 内建效应) {
        变量 诊断文本 = "函数 `" + 当前函数 + "` 没有声明效应 `" + 内建效应 + "`，不能调用内建 `" + 名 + "`"
        错误们 = 追加(错误们, {"错误码": "AGL-E-0402", "说明": 诊断文本})
      }
    }
    返回 错误们
  }
  变量 诊断文本 = "函数 `" + 当前函数 + "` 调用了未定义的函数 `" + 名 + "`"
  返回 追加(错误们, {"错误码": "AGL-E-0302", "说明": 诊断文本})
}

函数 非包含(名单: 列表, 项: 任意) -> 布尔 {
  如果 包含(名单, 项) {
    返回 假
  }
  返回 真
}

// ── 入口：检查整份 IR，返回错误列表（空 = 通过）────────────────────
导出 函数 检查程序(ir数据: 映射表) -> 列表 {
  变量 错误们 = []
  循环 模块项 在 ir数据["program"]["modules"] {
    变量 函数名单 = []
    变量 函数效应表 = {}
    变量 类型名单 = []
    循环 类型项 在 取值(模块项, "types", []) {
      类型名单 = 追加(类型名单, 类型项["name"])
    }
    函数效应表["__类型__"] = 类型名单
    循环 函数项 在 模块项["functions"] {
      如果 取值(函数项, "种类", "") 等于 "变量" {
        继续
      }
      函数名单 = 追加(函数名单, 函数项["name"])
      函数效应表[函数项["name"]] = 取值(函数项, "effects", [])
    }
    循环 函数项 在 模块项["functions"] {
      如果 取值(函数项, "种类", "") 等于 "变量" {
        继续
      }
      变量 调用者效应 = 取值(函数项, "effects", [])
      错误们 = 走语句们(取值(函数项, "body", []), 函数名单, 函数效应表,
                       调用者效应, 函数项["name"], 错误们)
      错误们 = 走表达式们(取值(函数项, "checks", []), 函数名单, 函数效应表,
                         调用者效应, 函数项["name"], 错误们)
    }
  }
  返回 错误们
}
