#语言=中文
// 自举：AGL 词法器 + AGL 语法分析器 + AGL 字节码生成。
// 只覆盖 `函数 主入口() { 打印("…") }`，产出可被 `aglc run` 直接执行的 .agb。
模块 编译器
导入 词法器
导入 语法分析器

函数 取常量(状态: 映射表, 值: 任意) -> 整数 {
  变量 常量们 = 状态["常量们"]
  变量 位置 = 常量们.长度
  状态["常量们"] = 追加(常量们, 值)
  返回 位置
}

函数 取名字(状态: 映射表, 名: 文本) -> 整数 {
  变量 名字们 = 状态["名字们"]
  变量 位置 = 名字们.长度
  状态["名字们"] = 追加(名字们, 名)
  返回 位置
}

函数 发射(状态: 映射表, 指令: 映射表, 行号: 整数) {
  状态["指令们"] = 追加(状态["指令们"], 指令)
  状态["行号们"] = 追加(状态["行号们"], 行号)
}

函数 编译表达式(状态: 映射表, 节点: 映射表) -> 整数 {
  如果 节点["种类"] 等于 "文本" {
    变量 原文 = 节点["文本"]
    返回 取常量(状态, 替换(原文, "\"", "", -1))
  }
  如果 节点["种类"] 等于 "数字" {
    返回 取常量(状态, 取到(转整数(节点["文本"], 0)))
  }
  如果 节点["种类"] 等于 "名字" {
    返回 取名字(状态, 节点["名字"])
  }
  打印("编译器：暂不支持的表达式", 节点["种类"])
  返回 0
}

函数 编译语句(状态: 映射表, 节点: 映射表) {
  如果 节点["种类"] 等于 "表达式" {
    编译语句(状态, 节点["值"])
    返回
  }
  如果 节点["种类"] 等于 "调用" {
    变量 目标 = 节点["目标"]
    如果 目标["种类"] 等于 "名字" 并且 目标["名字"] 等于 "打印" {
      变量 参数们 = 节点["参数"]
      循环 参数 在 参数们 {
        变量 槽 = 编译表达式(状态, 参数)
        发射(状态, {"op": "LOAD_CONST", "arg": 槽}, 5)
      }
      变量 名槽 = 取名字(状态, "print")
      发射(状态, {"op": "CALL_BUILTIN", "arg": {"name": 名槽, "argc": 参数们.长度}}, 5)
      发射(状态, {"op": "POP"}, 5)
    }
  }
}

函数 编译函数(状态: 映射表, 节点: 映射表) {
  变量 体 = 节点["体"]
  循环 语句 在 体 {
    编译语句(状态, 语句)
  }
  发射(状态, {"op": "LOAD_CONST", "arg": 0}, 4)
  发射(状态, {"op": "RETURN"}, 4)
}

函数 找主入口(程序: 列表) -> 映射表 {
  循环 节点 在 程序 {
    如果 节点["种类"] 等于 "函数" 并且 节点["名字"] 等于 "主入口" {
      返回 节点
    }
  }
  返回 {"种类": "空"}
}

函数 主入口() 效应 读写 {
  变量 源码 = 取到(读文件("tests/golden/hello_zh.agl"))
  变量 记号们 = 词法器.词法分析(源码)
  变量 程序 = 语法分析器.解析程序(记号们)
  变量 入口节点 = 找主入口(程序)
  如果 入口节点["种类"] 等于 "空" {
    打印("编译器：找不到主入口")
    返回
  }

  变量 状态 = {"常量们": [空], "名字们": [], "指令们": [], "行号们": []}
  编译函数(状态, 入口节点)

  变量 字节码 = {
    "format": "AGB",
    "version": 0,
    "lang": "zh",
    "module": "hello_zh",
    "entry": "主入口",
    "consts": 状态["常量们"],
    "names": 状态["名字们"],
    "types": [],
    "init": {"name": "<init>", "params": [], "effects": [],
             "code": [{"op": "LOAD_CONST", "arg": 0}, {"op": "RETURN"}],
             "lines": [1, 1]},
    "functions": [{"name": "主入口", "params": [], "effects": [],
                   "code": 状态["指令们"], "lines": 状态["行号们"]}]
  }
  变量 输出目录 = "build/自举编译器"
  建文件夹(输出目录)
  变量 json文本 = 取到(生成JSON(字节码))
  取到(写文件(输出目录 + "/selfhost_hello.agb", json文本))
  打印("编译器：已产出 selfhost_hello.agb，指令", 状态["指令们"].长度)
}
