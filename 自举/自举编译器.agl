#语言=中文
// 自举 B4c-1：把「词法 → 语法 → IR → AGB」收进一个 AGL 编译器入口。
// 这个程序本身由 Python 种子编译成 .agb；然后用默认 VM 跑它，让它再编译 full_zh。
// 还不是「编译器编译自己」，但已经把整条编译链收进 AGL 代码。
模块 自举编译器
导入 词法器
导入 语法分析器
导入 中间表示
导入 字节码
导入 校验器

函数 加载模块(目标模块: 文本, 已加载: 列表, 基目录: 文本) -> 列表 效应 读写 {
  如果 包含(已加载, 目标模块) {
    返回 [[], 已加载]
  }
  变量 新已加载 = 追加(已加载, 目标模块)
  // T7：导入解析先找入口源码同目录，找不到再回 自举/（自举编译器自己的模块）。
  变量 源码 = ""
  如果 基目录 不等于 "" {
    变量 本地路径 = 基目录 + "/" + 目标模块 + ".agl"
    如果 存在(本地路径) {
      源码 = 取到(读文件(本地路径))
    } 否则 {
      源码 = 取到(读文件("自举/" + 目标模块 + ".agl"))
    }
  } 否则 {
    源码 = 取到(读文件("自举/" + 目标模块 + ".agl"))
  }
  变量 程序 = 语法分析器.解析程序(词法器.词法分析(源码))
  变量 函数们 = []
  循环 节点 在 程序 {
    如果 节点["种类"] 等于 "函数" {
      如果 节点["名字"] 不等于 "主入口" {
        函数们 = 追加(函数们, 节点)
      }
    } 否则 如果 节点["种类"] 等于 "类型声明" {
      函数们 = 追加(函数们, 节点)
    } 否则 如果 节点["种类"] 等于 "变量" {
      函数们 = 追加(函数们, 节点)
    } 否则 如果 节点["种类"] 等于 "导入" {
      变量 子结果 = 加载模块(节点["名字"], 新已加载, 基目录)
      新已加载 = 子结果[1]
      循环 子函数 在 子结果[0] {
        函数们 = 追加(函数们, 子函数)
      }
    }
  }
  返回 [函数们, 新已加载]
}

函数 主入口() 效应 读写 {
  变量 源路径 = "input.agl"
  变量 模块名 = "main"
  变量 输出名 = "output.agb"
  变量 覆盖源 = 环境变量("AGL_BOOTSTRAP_SOURCE")
  如果 覆盖源 不等于 空 并且 覆盖源 不等于 "" {
    源路径 = 覆盖源
  }
  变量 覆盖模块 = 环境变量("AGL_BOOTSTRAP_MODULE")
  如果 覆盖模块 不等于 空 并且 覆盖模块 不等于 "" {
    模块名 = 覆盖模块
  }
  变量 覆盖输出 = 环境变量("AGL_BOOTSTRAP_OUTPUT")
  如果 覆盖输出 不等于 空 并且 覆盖输出 不等于 "" {
    输出名 = 覆盖输出
  }
  变量 源码 = 取到(读文件(源路径))
  变量 语言 = "zh"
  如果 包含(源码, "#语言=en") 或 包含(源码, "#lang=English") {
    语言 = "en"
  }
  // T4：解析失败要报 AGL 错误码 + 行号，而不是继续往下编出垃圾字节码。
  变量 解析结果 = 语法分析器.解析程序带错误(词法器.词法分析(源码))
  变量 程序 = 解析结果[0]
  如果 解析结果[1] 不等于 空 {
    变量 故障 = 解析结果[1]
    打印("自举编译器：解析失败", 故障["错误码"], "第", 故障["行"], "行，期望", 故障["期望"], "实际", 故障["实际"])
    返回
  }

  // T7：导入解析基目录 = 入口源码所在目录（最后一个 / 或 \ 之前）。
  变量 源分隔位 = rfind(源路径, "/")
  变量 源反斜位 = rfind(源路径, "\\")
  如果 源反斜位 大于 源分隔位 {
    源分隔位 = 源反斜位
  }
  变量 基目录 = ""
  如果 源分隔位 大于 0 {
    基目录 = 转文本(切片(源路径, 0, 源分隔位))
  }

  // B4c-2 的模块扁平化：把导入模块的函数并入主程序，只保留主入口；
  // 跨模块调用 `词法器.词法分析(...)` 由 IR 层降成同名全局调用。
  变量 已加载 = [模块名]
  变量 函数们 = []
  循环 节点 在 程序 {
    如果 节点["种类"] 等于 "函数" {
      函数们 = 追加(函数们, 节点)
    } 否则 如果 节点["种类"] 等于 "类型声明" {
      函数们 = 追加(函数们, 节点)
    } 否则 如果 节点["种类"] 等于 "变量" {
      // 顶层常量在自举解析器里是「变量」节点；带上它，
      // 转换程序才会把 consts 写进 IR。
      函数们 = 追加(函数们, 节点)
    } 否则 如果 节点["种类"] 等于 "导入" {
      变量 子结果 = 加载模块(节点["名字"], 已加载, 基目录)
      已加载 = 子结果[1]
      循环 子函数 在 子结果[0] {
        函数们 = 追加(函数们, 子函数)
      }
    }
  }

  变量 临时根 = 环境变量("TEMP")
  如果 临时根 等于 空 {
    临时根 = "."
  }
  如果 临时根 等于 "" {
    临时根 = "."
  }
  变量 产物目录 = 临时根 + "/agl_agb"
  建文件夹(产物目录)
  变量 ir数据 = 中间表示.转换程序(函数们, 模块名, 语言)
  // T21：自举侧第一层静态校验（未定义调用 + 效应传导）。
  // 种子 `aglc check` 已在前面拦住大部分静态错误；这里保证自举链自己的
  // IR 也过同一类检查，避免不同入口产生不同诊断。
  变量 校验错误 = 校验器.检查程序(ir数据)
  如果 校验错误.长度 大于 0 {
    变量 首个错误 = 校验错误[0]
    打印("自举编译器：静态检查未通过", 首个错误["错误码"], 首个错误["说明"])
    返回
  }
  变量 覆盖IR = 环境变量("AGL_BOOTSTRAP_OUTPUT_IR")
  如果 覆盖IR 不等于 空 并且 覆盖IR 不等于 "" {
    取到(写文件(覆盖IR, 取到(生成JSON(ir数据))))
  }
  变量 agb = 字节码.编译程序(ir数据)
  变量 json文本 = 取到(生成JSON(agb))
  // 默认仍写进临时产物根目录；设置 AGL_BOOTSTRAP_OUTPUT_FULL=1 时
  // 输出名就是完整路径（`aglc build --compiler agl` 用它直接落盘到工程目录）。
  变量 输出路径 = 产物目录 + "/" + 输出名
  变量 全路径 = 环境变量("AGL_BOOTSTRAP_OUTPUT_FULL")
  如果 全路径 等于 "1" {
    输出路径 = 输出名
  }
  // 产物可能带子目录（相对模式 gui_selfhost/x.agb、绝对模式深目录）：
  // 写之前按最后一个分隔符建父目录，避免把「目录没建」误报成编译失败。
  变量 分隔位 = rfind(输出路径, "/")
  变量 反斜位 = rfind(输出路径, "\\")
  如果 反斜位 大于 分隔位 {
    分隔位 = 反斜位
  }
  如果 分隔位 大于 0 {
    建文件夹(转文本(切片(输出路径, 0, 分隔位)))
  }
  取到(写文件(输出路径, json文本))
  打印("自举编译器：", 模块名, "→ AGB，函数", agb["functions"].长度)
}
