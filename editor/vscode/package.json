{
  "name": "agl-language",
  "displayName": "AGL",
  "description": "AGL（Agent Grounded Language）：中英双分支语法高亮 + 诊断 / 悬停 / 补全 / 大纲 / 跳转",
  "version": "0.4.0",
  "publisher": "agl",
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "agl",
    "中文编程",
    "agent",
    "chinese"
  ],
  "activationEvents": [
    "onLanguage:agl"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "agl",
        "aliases": [
          "AGL",
          "agl"
        ],
        "extensions": [
          ".agl"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "agl",
        "scopeName": "source.agl",
        "path": "./syntaxes/agl.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "AGL",
      "properties": {
        "agl.pythonPath": {
          "type": "string",
          "default": "python",
          "description": "运行 agl-lsp 的 Python 解释器（找不到命令时填绝对路径）"
        },
        "agl.serverModule": {
          "type": "string",
          "default": "compiler.lsp",
          "description": "语言服务模块名（一般不用改）"
        }
      }
    }
  },
  "scripts": {
    "check": "node --check extension.js"
  }
}
