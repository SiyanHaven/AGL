#lang=English
// Standard library: math. Written in AGL itself, so it is pure and effect-free.
// Usage: declare `math = "0.1.0"` under [dependencies] in agl.toml,
//        then `import math`, then `math.abs(-3)`.

module math

export fn abs(n: Int) -> Int {
  if n < 0 {
    return 0 - n
  }
  return n
}

export fn max_of(a: Int, b: Int) -> Int {
  if a > b {
    return a
  }
  return b
}

export fn min_of(a: Int, b: Int) -> Int {
  if a < b {
    return a
  }
  return b
}

export fn square(n: Int) -> Int {
  return n * n
}

export fn is_negative(n: Int) -> Bool {
  return n < 0
}

// ── added in stage 2 (still pure, still no external capability) ─────────────

export fn remainder(a: Int, b: Int) -> Int {
  // b == 0 raises "cannot divide by zero"; it does not quietly return 0
  return a % b
}

export fn power(base: Int, exponent: Int) -> Int {
  // non-negative exponents only; a negative one returns 0, because Int cannot hold 1/2
  if exponent < 0 {
    return 0
  }
  let built = 1
  let done = 0
  while done < exponent {
    built = built * base
    done = done + 1
  }
  return built
}

export fn clamp(value: Int, low: Int, high: Int) -> Int {
  // squeeze value into [low, high]; if low > high, low wins — no exception
  if value < low {
    return low
  }
  if value > high {
    return high
  }
  return value
}

export fn is_even(n: Int) -> Bool {
  return n % 2 == 0
}

