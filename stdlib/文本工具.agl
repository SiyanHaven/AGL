#语言=中文
// 标准库：文本工具。全部用 AGL 自己写，纯函数、零效应。
// 用法：在 agl.toml 的 [dependencies] 里写 `"文本工具" = "0.2.0"`，再 `导入 文本工具`。
//
// 边界说明（不藏着）：切片越界会直接报错，所以下面每个函数都先判断长度够不够，
// 该返回「假」或 -1 的地方就明确返回，绝不靠"截断成短一段"糊过去。

模块 文本工具

导出 函数 按行切分(内容: 文本) -> 列表<文本> {
  返回 切分(内容, "\n")
}

导出 函数 以开头(内容: 文本, 前缀: 文本) -> 布尔 {
  如果 前缀.长度 大于 内容.长度 {
    返回 假
  }
  返回 切片(内容, 0, 前缀.长度) 等于 前缀
}

导出 函数 以结尾(内容: 文本, 后缀: 文本) -> 布尔 {
  如果 后缀.长度 大于 内容.长度 {
    返回 假
  }
  返回 切片(内容, 内容.长度 - 后缀.长度, 内容.长度) 等于 后缀
}

导出 函数 重复(内容: 文本, 次数: 整数) -> 文本 {
  变量 拼好 = ""
  变量 已做 = 0
  当 已做 小于 次数 {
    拼好 = 拼接(拼好, 内容)
    已做 = 已做 + 1
  }
  返回 拼好
}

导出 函数 在何处(内容: 文本, 目标: 文本) -> 整数 {
  // 找不到返回 -1；空目标返回 0（与大多数语言的约定一致）
  如果 目标.长度 等于 0 {
    返回 0
  }
  如果 目标.长度 大于 内容.长度 {
    返回 0 - 1
  }
  变量 位置 = 0
  当 位置 + 目标.长度 小于等于 内容.长度 {
    如果 切片(内容, 位置, 位置 + 目标.长度) 等于 目标 {
      返回 位置
    }
    位置 = 位置 + 1
  }
  返回 0 - 1
}

导出 函数 计数(内容: 文本, 目标: 文本) -> 整数 {
  // 不重叠计数：「甲甲甲」里数「甲甲」得 1，不是 2
  如果 目标.长度 等于 0 {
    返回 0
  }
  变量 次数 = 0
  变量 位置 = 0
  当 位置 + 目标.长度 小于等于 内容.长度 {
    如果 切片(内容, 位置, 位置 + 目标.长度) 等于 目标 {
      次数 = 次数 + 1
      位置 = 位置 + 目标.长度
    } 否则 {
      位置 = 位置 + 1
    }
  }
  返回 次数
}
