#语言=中文
// 用例：扩充后的标准库真能干活

导入 文本工具
导入 列表工具
导入 数学

函数 主入口() {
  变量 数们 = [3, 1, 2, 1]
  打印("排序", 列表工具.排序(数们))
  打印("原样", 数们)
  打印("去重", 列表工具.去重(数们))
  打印("反转", 列表工具.反转(数们))
  打印("找 2", 列表工具.查找下标(数们, 2))
  打印("找 9", 列表工具.查找下标(数们, 9))
  打印("取前 2", 列表工具.取前(数们, 2))
  打印("取前 99", 列表工具.取前(数们, 99))
  打印("连接", 列表工具.连接成文本(["甲", "乙", "丙"], "-"))

  打印("重复", 文本工具.重复("ab", 3))
  打印("开头", 文本工具.以开头("你好世界", "你好"))
  打印("结尾", 文本工具.以结尾("你好世界", "世界"))
  打印("结尾错", 文本工具.以结尾("你好世界", "世界你好"))
  打印("在何处", 文本工具.在何处("甲乙丙乙", "乙"))
  打印("找不到", 文本工具.在何处("甲乙丙", "丁"))
  打印("计数", 文本工具.计数("甲甲甲甲", "甲甲"))
  打印("按行", 文本工具.按行切分("第一行\n第二行"))

  打印("取余", 数学.取余(17, 5))
  打印("幂", 数学.幂(2, 10))
  打印("限制", 数学.限制在(99, 0, 10))
  打印("偶数", 数学.是偶数(10))
}
