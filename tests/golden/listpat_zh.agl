#语言=中文
// 列表模式：精确长度、元素字面量、多个绑定、守卫读取绑定、非列表走兜底

函数 主入口() {
  变量 值 = [2, 0]
  匹配 (值) {
    [变量 甲, 0] {
      打印("尾零", 甲)
    }
    [变量 甲, 变量 乙] 如果 甲 大于 1 {
      打印("两值", 甲, 乙)
    }
    [1, 变量 乙] {
      打印("首一", 乙)
    }
    否则 {
      打印("无")
    }
  }

  变量 另 = [3, 9]
  匹配 (另) {
    [1, 变量 乙] {
      打印("首一", 乙)
    }
    [变量 甲, 变量 乙] 如果 乙 大于 4 {
      打印("守卫", 甲, 乙)
    }
    否则 {
      打印("无二")
    }
  }

  变量 矩阵 = [2, [7, 9]]
  匹配 (矩阵) {
    [0, [变量 甲, 变量 乙]] { 打印("错层", 甲, 乙) }
    [2, [7, 变量 尾]] { 打印("嵌套", 尾) }
    [变量 外, [变量 甲, 变量 乙]] { 打印("全绑定", 外, 甲, 乙) }
    否则 { 打印("无嵌套") }
  }

  变量 扁 = [2, [7]]
  匹配 (扁) {
    [2, [7, 变量 尾]] { 打印("不该命中", 尾) }
    否则 { 打印("短内层") }
  }

  变量 单 = [7]
  匹配 (单) {
    [变量 唯一] {
      打印("单", 唯一)
    }
    否则 {
      打印("兜底")
    }
  }

  变量 数 = 5
  匹配 (数) {
    [变量 项] {
      打印("列表", 项)
    }
    否则 {
      打印("非列表")
    }
  }
}
