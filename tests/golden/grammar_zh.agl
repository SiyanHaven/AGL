#语言=中文
// 意图: 覆盖阶段 1 全部可用语法（循环 / 当 / 尝试-捕获 / 列表 / 映射表 /
//       否则如果 链 / 校验块 / 效应声明 / 赋值 / 下标 / 成员），并验证
//       「校验」与「效应」的顺序不限。

函数 求和(数字们: 列表<整数>) -> 整数
校验 {
  数字们 不等于 空
}
{
  变量 总 = 0
  循环 每个 在 数字们 {
    总 = 总 + 每个
  }
  返回 总
}

函数 分类(分数: 整数) -> 文本 {
  如果 分数 大于等于 90 {
    返回 "优"
  } 否则 如果 分数 大于等于 60 {
    返回 "良"
  } 否则 {
    返回 "差"
  }
}

函数 读配置(路径: 文本) -> 文本
校验 {
  路径 不等于 ""
}
效应 读写
{
  返回 路径
}

函数 主入口() {
  变量 表 = [1, 2, 3]
  打印(求和(表))
  打印(分类(95))
  打印(分类(70))
  打印(分类(10))

  变量 计数 = 0
  当 计数 小于 3 {
    计数 = 计数 + 1
  }
  打印(计数)

  尝试 {
    打印(1 / 0)
  } 捕获 (错) {
    打印("除零被捕获")
  }

  变量 配置 = {"主机": "本地", "端口": 8080}
  打印(配置["主机"])

  打印("分号收尾");   // 行尾分号可省略可写（C 系习惯兼容）
  /* 块注释：可跨行
     第二行也在注释里 */
  打印("块注释后")
}
