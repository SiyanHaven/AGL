#lang=English
fn main() {
  let a = match 3 {
    1 => "one"
    let value => value * 2
    _ => 0
  }
  print(a)
  let b = match {"x": 1} {
    {"x": let value} => value + 8
    _ => 0
  }
  print(b)
  let c = match [1, 2] {
    [1, let tail] => tail
    _ => 0
  }
  print(c)
  let d = match 7 {
    let value if value > 5 => "big"
    _ => "small"
  }
  print(d)
}
