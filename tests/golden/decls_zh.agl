#语言=中文
工具 读取文件 {
  入参(文件路径: 文本)
  返回 文本?
  配置 {
    协议 = "mcp"
    地址 = "http://127.0.0.1:8080/mcp"
    最大重试次数 = 2
    超时秒数 = 10
    权限 = ["文件只读"]
    订阅 = 假
  }
}

智能体 调研助手 {
  目标 = "完成主题调研并给出带来源的结论"
  入参(主题: 文本)
  返回 文本
  配置 {
    模型 = "调研模型"
  }
}

规则 数据脱敏 {
  版本 = 2
  生效范围 = 全项目
  优先级 = 高
  内容 = "输出任何文本前先脱敏手机号与身份证号"
}

规则 报告语气 {
  版本 = 1
  生效范围 = 模块 财务报告
  优先级 = 普通
  内容 = "报告结论必须附数据来源"
  过期时间 = 2026-12-31
}

函数 主入口() {
  打印("decls ok")
}
