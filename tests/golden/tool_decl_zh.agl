#语言=中文
// 意图: 阶段 2 声明块（工具/智能体/规则）进入自举覆盖范围：解析 + 记录，不产生运行期代码。

工具 加载文本 {
  入参(文件路径: 文本)
  返回 文本
  配置 {
    协议 = "mcp"
    地址 = "http://127.0.0.1:8080/mcp"
    最大重试次数 = 2
    超时秒数 = 10
    订阅 = 假
  }
}

智能体 调研员 {
  入参(主题: 文本)
  返回 文本
  目标 = "围绕主题产出一份调研摘要"
}

规则 禁止删库 {
  版本 = 1
  生效范围 = 全项目
  内容 = "任何情况下不得删除数据库"
  优先级 = 高
}

函数 主入口() {
  打印("声明块解析通过")
}
