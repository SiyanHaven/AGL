#lang=English
// full set algebra: union / intersection / difference / symmetric difference / subset / superset
fn main() {
  let a = {1, 2, 3}
  let b = {3, 4}
  print("union", set_union(a, b))
  print("inter", set_intersection(a, b))
  print("diff", set_difference(a, b))
  print("sym", set_symmetric_difference(a, b))
  print("sub", is_subset({1, 2}, a), is_subset(a, {1, 2}))
  print("sup", is_superset(a, {1, 2}), is_superset({1, 2}, a))
}