#语言=中文
// 匹配守卫：同值分支按守卫顺序判断；守卫为假继续向下；_ 守卫也生效
函数 主入口() {
  变量 x = 2
  变量 允许 = 真
  匹配 (x) {
    2 如果 允许 { 打印("g1") }
    2 如果 假 { 打印("g2") }
    _ { 打印("other") }
  }
  匹配 (x) {
    1 如果 允许 { 打印("no") }
    _ 如果 允许 { 打印("fallback") }
  }
  匹配 (x) {
    _ 如果 假 { 打印("never") }
  }
  匹配 (x) {
    1 { 打印("one") }
    否则 如果 x 大于 1 { 打印("elseif") }
    否则 { 打印("else") }
  }
  打印("end")
}