#语言=中文
// v0.23 能力固化：匹配分支（含 _ 通配）+ 类型化捕获（宿主真异常）
函数 等级(数: 整数) -> 文本 {
  变量 级名 = "其他"
  匹配 (数) {
    1 { 级名 = "低" }
    2 { 级名 = "中" }
  }
  返回 级名
}

函数 主入口() {
  打印(等级(1))
  打印(等级(2))
  打印(等级(9))
  匹配 ("hello") {
    "hi" { 打印("碰面") }
    _ { 打印("其他文本") }
  }
  尝试 {
    变量 甲 = [1, 2, 3]
    打印(甲[9])
  } 捕获 (错: 下标越界) {
    打印("越界被接住：", 错)
  }
  尝试 {
    变量 乙 = {"甲": 1}
    打印(乙["乙"])
  } 捕获 (错: 键错误) {
    打印("缺键被接住")
  }
}
