// v0.53 扩充内建的双分支覆盖：只编译不真跑（涉及磁盘、数据库、端口）
函数 扩展内建演示() -> 整数 效应 读写 {
  变量 存在与否 = 存在("临时.txt")
  变量 目录们 = 列目录(".")
  建文件夹("临时目录")
  删除文件("临时.txt")
  变量 参数们 = 命令行参数()
  变量 合并路径 = 路径拼接("data", "config.json")
  重命名("旧.txt", "新.txt")
  变量 大小 = 文件大小("临时.txt")
  变量 是目录 = 是文件夹("data")
  变量 是普通文件 = 是文件("临时.txt")
  变量 目录内容 = 遍历目录(".")
  变量 当前 = 当前目录()
  变量 哈希 = MD5("abc")
  变量 摘要 = SHA256("abc")
  变量 环境 = 环境变量("PATH")
  变量 库 = 打开数据库("todo.db")
  执行SQL(库, "CREATE TABLE IF NOT EXISTS t(x)")
  查询SQL(库, "SELECT 1")
  执行SQL带参(库, "INSERT INTO t VALUES(?)", [1])
  查询SQL带参(库, "SELECT * FROM t WHERE x=?", [1])
  关闭数据库(库)
  变量 表格 = 读CSV("数据.csv")
  写CSV("数据.csv", 表格)
  返回 目录内容.长度
}

函数 扩展计时演示() -> 文本 效应 计时 {
  返回 现在时间()
}

