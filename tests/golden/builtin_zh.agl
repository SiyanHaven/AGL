#语言=中文
// 意图: 内建函数（切片 / 切分 / 拼接 / 替换 / 去空白 / 大小写 / 包含 / 转文本 /
//       追加 / 子列表 / 转整数 / 转浮数）在两个分支上产出同一份 IR；
//       会失败的一律走「结果」，不抛异常；越界属于错误，不静默截断。
//       后半段覆盖异步内建（任务 / 睡眠 / 当任务完成 / 上报进度 / 取消）。

异步 函数 慢() -> 文本 效应 计时 {
  等待 睡眠(1)
  返回 "ok"
}

函数 闭包0(x: 整数) -> 整数 {
  返回 x + 5
}

函数 取长度(x: 文本) -> 任意 {
  返回 x.长度
}

异步 函数 主入口() 效应 计时 读写 {
  变量 句子 = "甲,乙,丙"
  变量 段们 = 切分(句子, ",")
  打印("段数", 段们.长度)
  打印("首段", 段们[0])

  打印("切片", 切片("你好世界", 1, 3))
  打印("空切片长度", 切片("甲乙", 1, 1).长度)
  打印("按字切分", 切分("甲乙", ""))
  打印("拼接", 拼接("甲", "乙", "丙"))
  打印("替换", 替换("甲乙甲", "甲", "丁"))
  打印("转义HTML", 转义HTML("<a> & b"))
  打印("编码URL", 编码URL("你好 A/B"))
  打印("解码URL", 解码URL("%E4%BD%A0%E5%A5%BD"))
  打印("去空白", 去空白("  中间  "))
  打印("大写", 转大写("abc"))
  打印("小写", 转小写("ABC"))
  打印("包含", 包含("甲乙", "乙"))
  打印("不包含", 包含("甲乙", "丙"))
  打印("转文本", 转文本(42))
  打印("格式化数字", 格式化数字(3.14159, 2))
  打印("宽格式", 格式化数字(3.14159, 2, 10))
  打印("求和", 合计([1, 2, 3]))
  打印("取整", 取整(1.9))
  打印("负取整", 取整(0 - 1.9))
  打印("上取整", 上取整(3.2))
  打印("下取整", 下取整(3.9))
  打印("最大默认", 最大默认([], 0))
  打印("最小默认", 最小默认([], -1))
  变量 自造成功 = 成功(7)
  打印("自造成功", 自造成功)
  变量 自造失败 = 失败("故意的")
  打印("自造失败", 自造失败)

  变量 原 = [1, 2]
  变量 新 = 追加(原, 3)
  打印("原列表", 原)
  打印("新列表", 新)
  打印("子列表", 子列表(新, 1, 3))
  打印("空子列表", 子列表(原, 0, 0))

  变量 数 = 转整数("42")
  如果 数 {
    打印("整数", 取到(数))
  }
  变量 坏 = 转整数("四十二")
  如果 非 坏 {
    打印("不是整数", 失败原因(坏))
  }
  变量 fn_ref = ["闭包0"]
  打印("调用", 调用(fn_ref, 3))
  打印("浮数", 转浮数("1.5"))
  打印("绝对值", 绝对值(-3.14))
  打印("最小值", 最小值(3, 5))
  打印("最大值", 最大值(3, 5))
  打印("最小值列表", 最小值([3, 1, 2]))
  打印("最大值列表", 最大值([3, 1, 2]))
  打印("多值最大", 最大值(3, 5, 9, 1))
  打印("填充", 填充("{} 在 {}，买 {} 本", "小明", "杭州", 3))
  打印("正则匹配", 正则匹配("abc123", "\\d+"))
  打印("正则不匹配", 正则匹配("abc", "\\d+"))
  打印("正则替换", 正则替换("a1b2", "\\d", "X"))
  打印("是数字", 是数字("123"), 是数字("12a"))
  打印("是字母", 是字母("abc"), 是字母("a1"))
  打印("查找", 查找("甲乙丙", "乙"), 查找("甲乙", "丁"))
  打印("以开头", 以开头("甲乙", "甲"))
  打印("以结尾", 以结尾("甲乙", "乙"))
  打印("取值", 取值({"甲": 1}, "甲", 0), 取值({"甲": 1}, "乙", 0))
  // 语句起始的整串内建名不被前缀切分（`当前时间戳` 不会变成 `当` + `前时间戳`）
  当前时间戳()
  变量 此刻 = 当前时间戳()
  打印("格式化时间", 格式化时间("%Y"))
  打印("合并映射", 合并映射({"甲": 1}, {"乙": 2}))
  打印("拼接列表", 拼接列表("-", ["甲", "乙", "丙"]))
  打印("排序", 排序([3, 1, 2]))
  打印("按键排序", 按键排序(["bb", "a", "ccc"], 取长度))
  打印("反转", 反转([1, 2, 3]))
  打印("等同", 等同(1, 1), 等同([1], [1]))
  打印("不等同", 不等同(1, 2), 不等同([1], [1]))

  // —— 异步内建覆盖 ——
  变量 句柄 = 任务(慢())
  当任务完成(句柄, 返回值: 文本) { 打印("完成", 返回值) }
  变量 r = 等待 句柄
  打印("结果", r)
  取消(句柄)
  上报进度("done")

  // —— 文件 IO 内建覆盖（只编译不运行，故写的是缺省路径，不会真落盘）——
  变量 读探针 = 读文件("缺省.txt")
  打印("读缺省", 失败原因(读探针))
  变量 写探针 = 写文件("临时.txt", "内容")
  打印("写探针", 写探针)
}

// 随机数运行值不定，黄金用例只编译不真跑（主入口不调用它）
函数 随机演示() -> 整数 {
  变量 骰子 = 随机整数(1, 6)
  变量 签 = 随机选择([1, 2, 3])
  变量 抽 = 随机选([1, 2, 3])
  随机种子(1)
  返回 骰子
}

// 读入 会挂起等输入、追加写文件 会真落盘，同样只编译不真跑
函数 输入演示() -> 文本 效应 读写 {
  变量 行 = 读入("请输入：")
  变量 追 = 追加写文件("临时.txt", 行)
  返回 行
}

// v0.24 集合 / JSON / 网络（网络会真发请求，只编译不真跑）
函数 集合演示() -> 集合<整数> {
  变量 s = 建集合(1, 2, 3)
  变量 t = 添加(s, 4)
  变量 u = 并集(s, {3, 4})
  变量 v = 交集(s, {2, 3})
  变量 w = 差集(s, {2})
  变量 x = 对称差(s, {3, 4})
  变量 sub = 是子集({1, 2}, s)
  变量 sup = 是超集(s, {1, 2})
  变量 d = 取到(解析JSON("{\"a\": 1}"))
  变量 j = 取到(生成JSON(d))
  返回 w
}

函数 网页演示() -> 文本 效应 网络 {
  变量 r = 获取网页("https://example.com/")
  返回 取到(r)
}

// v0.25 计数 / 范围列表 / 可选提示 读入
函数 计数演示() -> 整数 {
  变量 s = "香蕉香蕉苹果"
  变量 子 = 计数(s, "香蕉")
  变量 xs = [1, 2, 2, 3]
  变量 元 = 计数(xs, 2)
  返回 子 + 元
}

函数 范围演示() -> 列表<整数> {
  变量 r1 = 范围列表(3)
  变量 r2 = 范围列表(2, 6)
  变量 r3 = 范围列表(0, 10, 3)
  返回 r3
}

函数 无提示读入() -> 文本 效应 读写 {
  变量 行 = 读入()
  返回 行
}

// v0.26 文本乘法 / 标题化 / 补零 / 去左空 / 去右空
函数 文本演示() -> 文本 {
  变量 重 = 重复("ab", 3)
  变量 题 = 标题化("hello world")
  变量 零 = 补零(转文本(7), 3)
  变量 左 = 去左空("  甲")
  变量 右 = 去右空("甲  ")
  返回 重 + 题 + 零 + 左 + 右
}

// v0.27 字符串方法族（ljust/rjust/center/去前缀/去后缀/大小写互换/首字母大写/is* 布尔族）+ 类型构造（转布尔/转列表/键列表/建映射）
函数 字符串方法演示() {
  打印("左对齐", 左对齐("abc", 5, "-"))
  打印("右对齐", 右对齐("abc", 5, "-"))
  打印("居中", 居中("abc", 7, "*"))
  打印("大小写互换", 大小写互换("AbC"))
  打印("首字母大写", 首字母大写("abc"))
  打印("去前缀", 去前缀("abc", "a"))
  打印("去后缀", 去后缀("abc", "c"))
  打印("是小写", 是小写("abc"))
  打印("是大写", 是大写("ABC"))
  打印("是空白", 是空白("  "))
  打印("是标题", 是标题("Hello World"))
  打印("是十进制", 是十进制("42"))
  打印("是数字串", 是数字串("42"))
  打印("转布尔", 转布尔(0))
  打印("转列表", 转列表("abc"))
  打印("键列表", 键列表({"a": 1}))
  打印("建映射", 建映射([["a", 1], ["b", 2]]))
}

