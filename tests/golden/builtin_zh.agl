  打印("清空列表", 清空([10, 20]))
  打印("清空映射", 清空(建映射([["a", 1]])))
  打印("千分位", 按格式(1234567, ","))
  打印("科学计数", 按格式(3.14159, ".3e"))
  打印("符号", 按格式(42, "+d"))
  打印("等对齐", 按格式(42, "=10"))
  打印("自定义填充", 按格式(42, "*<10"))
  打印("表达式形式", 表达式形式("甲"))
  打印("科学字面量", 1.23e-05)
}

