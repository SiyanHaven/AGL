  打印("切片反转", 反转([1, 2, 3]))
  打印("四舍五入", 四舍五入(3.7))
  打印("乘方", 乘方(2, 10))
  打印("整除余数", 整除余数(17, 5)[0], 整除余数(17, 5)[1])
  打印("字符码", 字符码("A"))
  打印("码字符", 码字符(66))
  打印("全真", 全真([真, 真]))
  打印("有真", 有真([假, 真]))
  打印("键值对列表", 键值对列表({"a": 1})[0][0])
  打印("值列表", 值列表({"a": 1})[0])
  打印("十六进制", 十六进制(255))
  打印("八进制", 八进制(8))
  打印("二进制", 二进制(10))
}

// v0.29 转整数 进制参数（int(x, base) 直译）双参覆盖
函数 进制转换演示() {
  打印("二进制转十进制", 取到(转整数("101", 2)))
  打印("十六进制转十进制", 取到(转整数("ff", 16)))
}

// v0.30 列表/映射方法族内建（弹出/移除元素/插入/元素位置/弹出键）双分支覆盖
函数 方法族演示() {
  变量 xs = [10, 20, 30]
  变量 ys, xs2 = 弹出(xs)
  打印("弹出尾部", ys, xs2)
  变量 y2, xs3 = 弹出(xs2, 0)
  打印("弹出下标", y2, xs3)
  打印("移除元素", 移除元素(xs3, 20))
  打印("插入", 插入([1, 3], 1, 2))
  打印("元素位置", 取到(元素位置([7, 8, 9], 8)))
  打印("元素位置缺失", 元素位置([7], 9))
  变量 d = 建映射([["a", 1], ["b", 2]])
  打印("弹出键", 弹出键(d, "a")[0], 弹出键(d, "a")[1])
  打印("弹出键缺省", 弹出键(d, "z", 9))
  // 格式说明进制与对齐（f-string 与 format 共用 _format_spec_conversion）
  打印("十六进制文本", 去前缀(十六进制(255), "0x"))
  打印("进制大写", 转大写(去前缀(十六进制(255), "0x")))
  打印("右对齐", 右对齐(转文本(7), 5))
  打印("左对齐", 左对齐(转文本(7), 5))
  打印("居中", 居中(转文本(7), 5))
  打印("补零", 补零(转文本(42), 5))
}

// v0.31 清空/按格式/表达式形式 + 科学计数法字面量（复杂格式原生透传）双分支覆盖
