#语言=中文
// 映射模式：键存在 + 值匹配，允许多余键；可嵌列表/映射
函数 主入口() {
  变量 m = {"类型": "ok", "值": 9, "嵌套": {"x": 1}, "列": [1, 2]}
  匹配 (m) {
    {"类型": "ok", "值": 变量 v} { 打印(v) }
    _ { 打印("no1") }
  }
  匹配 (m) {
    {"嵌套": {"x": 变量 x}} { 打印(x) }
    _ { 打印("no2") }
  }
  匹配 (m) {
    {"列": [1, 变量 尾]} { 打印(尾) }
    _ { 打印("no3") }
  }
  匹配 (m) {
    {"缺失": 1} { 打印("bad") }
    _ { 打印("fallback") }
  }
}
