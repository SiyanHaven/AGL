#语言=中文
// 待办清单：结构体列表、函数式更新、完成率统计。
// 运行：python -m compiler.cli run examples/zh/02_待办清单.agl

类型 任务 {
  标题: 文本
  做完: 布尔
}

函数 追加任务(任务们: 列表<任务>, 标题: 文本) -> 列表<任务> {
  返回 追加(任务们, 任务(标题: 标题, 做完: 假))
}

函数 标记完成(任务们: 列表<任务>, 目标: 文本) -> 列表<任务> {
  变量 整理后 = []
  循环 每个 在 任务们 {
    如果 每个.标题 等于 目标 {
      整理后 = 追加(整理后, 任务(标题: 每个.标题, 做完: 真))
    } 否则 {
      整理后 = 追加(整理后, 每个)
    }
  }
  返回 整理后
}

函数 完成数量(任务们: 列表<任务>) -> 整数 {
  变量 数量 = 0
  循环 每个 在 任务们 {
    如果 每个.做完 等于 真 {
      数量 = 数量 + 1
    }
  }
  返回 数量
}

函数 打印清单(任务们: 列表<任务>) {
  打印("待办清单")
  循环 每个 在 任务们 {
    变量 标记 = "[ ]"
    如果 每个.做完 等于 真 {
      标记 = "[x]"
    }
    打印(填充("{} {}", 标记, 每个.标题))
  }
  打印(填充("已完成 {}/{}", 完成数量(任务们), 任务们.长度))
}

函数 主入口() {
  变量 任务们 = [
    任务(标题: "写发布说明", 做完: 真),
    任务(标题: "检查 MCP 工具清单", 做完: 假),
    任务(标题: "跑一遍 doctor", 做完: 假)
  ]

  打印清单(任务们)
  打印("")
  任务们 = 追加任务(任务们, "整理示例索引")
  任务们 = 标记完成(任务们, "检查 MCP 工具清单")
  打印("更新后：")
  打印清单(任务们)
}
