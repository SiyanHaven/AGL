#语言=中文
// 日志分析：读取 UTF-8 日志，按级别统计，列出错误行。
// 运行（在仓库根目录）：python -m compiler.cli run examples/zh/03_日志分析.agl

函数 读日志(路径: 文本) -> 结果 效应 读写 {
  返回 读文件(路径)
}

函数 主入口() 效应 读写 {
  变量 日志路径 = 路径拼接("examples", "zh", "sample.log")
  变量 读取结果 = 读日志(日志路径)

  如果 读取结果 {
    变量 内容 = 取到(读取结果)
    变量 行们 = 分行列表(内容)
    变量 信息数 = 0
    变量 警告数 = 0
    变量 错误数 = 0
    变量 错误行 = []

    循环 每行 在 行们 {
      如果 包含(每行, "INFO") {
        信息数 = 信息数 + 1
      }
      如果 包含(每行, "WARN") {
        警告数 = 警告数 + 1
      }
      如果 包含(每行, "ERROR") {
        错误数 = 错误数 + 1
        错误行 = 追加(错误行, 每行)
      }
    }

    变量 错误率 = 0.0
    如果 行们.长度 大于 0 {
      错误率 = 错误数 / 行们.长度 * 100.0
    }

    打印("日志分析")
    打印("文件：sample.log")
    打印("总行数：", 行们.长度)
    打印("INFO：", 信息数, "  WARN：", 警告数, "  ERROR：", 错误数)
    打印("错误率：", 格式化数字(错误率, 1), "%")
    打印("")
    如果 错误数 大于 0 {
      打印("错误明细：")
      循环 每个 在 错误行 {
        打印("  ", 每个)
      }
    } 否则 {
      打印("没有发现错误。")
    }
  } 否则 {
    打印("读取日志失败：", 失败原因(读取结果))
  }
}
