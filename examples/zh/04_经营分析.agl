#语言=中文
// 月度经营分析：订单校验、区域汇总、预算差异、客户排行、风险提示、Markdown 报告。
// 运行（在仓库根目录）：python -m compiler.cli run examples/zh/04_经营分析.agl

类型 订单 {
  单号: 文本
  客户: 文本
  区域: 文本
  金额: 浮数
  状态: 文本
}

类型 区域预算 {
  区域: 文本
  预算: 浮数
}

类型 区域汇总 {
  区域: 文本
  收入: 浮数
  订单数: 整数
  完成数: 整数
  预算: 浮数
  差异: 浮数
  完成率: 浮数
}

函数 状态合法(状态: 文本) -> 布尔 {
  返回 状态 等于 "已完成" 或 状态 等于 "待付款" 或 状态 等于 "已取消"
}

函数 校验订单(订单: 订单) -> 结果 {
  如果 订单.单号.长度 等于 0 {
    返回 失败("单号为空")
  }
  如果 订单.金额 小于 0.0 {
    返回 失败(填充("金额为负数：{}", 格式化数字(订单.金额, 2)))
  }
  如果 非 状态合法(订单.状态) {
    返回 失败(填充("未知状态：{}", 订单.状态))
  }
  返回 成功(订单)
}

函数 查预算(预算表: 列表<区域预算>, 区域: 文本) -> 浮数 {
  循环 每个 在 预算表 {
    如果 每个.区域 等于 区域 {
      返回 每个.预算
    }
  }
  返回 0.0
}

函数 客户合计(订单们: 列表<订单>, 客户: 文本) -> 浮数 {
  变量 合计 = 0.0
  循环 每个 在 订单们 {
    如果 每个.状态 等于 "已完成" 并且 每个.客户 等于 客户 {
      合计 = 合计 + 每个.金额
    }
  }
  返回 合计
}

函数 最大客户(订单们: 列表<订单>) -> 文本 {
  变量 客户名 = "暂无"
  变量 最高 = 0.0
  循环 每个 在 订单们 {
    如果 每个.状态 等于 "已完成" {
      变量 合计 = 客户合计(订单们, 每个.客户)
      如果 合计 大于 最高 {
        最高 = 合计
        客户名 = 每个.客户
      }
    }
  }
  返回 客户名
}

函数 汇总区域(订单们: 列表<订单>, 区域: 文本, 预算表: 列表<区域预算>) -> 区域汇总 {
  变量 收入 = 0.0
  变量 订单数 = 0
  变量 完成数 = 0

  循环 每个 在 订单们 {
    如果 每个.区域 等于 区域 {
      订单数 = 订单数 + 1
      如果 每个.状态 等于 "已完成" {
        完成数 = 完成数 + 1
        收入 = 收入 + 每个.金额
      }
    }
  }

  变量 预算 = 查预算(预算表, 区域)
  变量 完成率 = 0.0
  如果 订单数 大于 0 {
    完成率 = 完成数 / 订单数 * 100.0
  }

  返回 区域汇总(
    区域: 区域,
    收入: 收入,
    订单数: 订单数,
    完成数: 完成数,
    预算: 预算,
    差异: 收入 - 预算,
    完成率: 完成率
  )
}

函数 生成报告(
  区域们: 列表<区域汇总>,
  有效订单们: 列表<订单>,
  无效记录: 列表<文本>,
  总预算: 浮数,
  总收入: 浮数
) -> 文本 {
  变量 行们 = []
  行们 = 追加(行们, "# 月度经营分析报告")
  行们 = 追加(行们, "")
  行们 = 追加(行们, 填充(
    "统计订单 {} 单：有效 {} 单，无效 {} 条。",
    有效订单们.长度 + 无效记录.长度,
    有效订单们.长度,
    无效记录.长度
  ))
  行们 = 追加(行们, "")
  行们 = 追加(行们, "## 总览")
  行们 = 追加(行们, 填充("- 总收入：{} 元", 格式化数字(总收入, 2)))
  行们 = 追加(行们, 填充("- 总预算：{} 元", 格式化数字(总预算, 2)))
  行们 = 追加(行们, 填充("- 预算差异：{} 元", 格式化数字(总收入 - 总预算, 2)))
  行们 = 追加(行们, 填充("- 最大客户：{}", 最大客户(有效订单们)))
  行们 = 追加(行们, "")
  行们 = 追加(行们, "## 区域明细")
  行们 = 追加(行们, "| 区域 | 收入 | 预算 | 差异 | 完成率 |")
  行们 = 追加(行们, "|---|---:|---:|---:|---:|")

  循环 每个 在 区域们 {
    行们 = 追加(行们, 填充(
      "| {} | {} | {} | {} | {} |",
      每个.区域,
      格式化数字(每个.收入, 2),
      格式化数字(每个.预算, 2),
      格式化数字(每个.差异, 2),
      填充("{}{}", 格式化数字(每个.完成率, 1), "%")
    ))
  }

  行们 = 追加(行们, "")
  行们 = 追加(行们, "## 风险提示")
  变量 风险们 = []

  循环 每个 在 区域们 {
    如果 每个.完成率 小于 60.0 {
      风险们 = 追加(风险们, 填充(
        "{} 完成率仅 {}，需要检查待付款订单。",
        每个.区域,
        填充("{}{}", 格式化数字(每个.完成率, 1), "%")
      ))
    }
    如果 每个.差异 小于 0.0 - 每个.预算 * 0.1 {
      风险们 = 追加(风险们, 填充(
        "{} 收入比预算低 {} 元。",
        每个.区域,
        格式化数字(0.0 - 每个.差异, 2)
      ))
    }
  }

  如果 无效记录.长度 大于 0 {
    风险们 = 追加(风险们, 填充("有 {} 条无效订单，已跳过。", 无效记录.长度))
  }

  如果 风险们.长度 等于 0 {
    行们 = 追加(行们, "- 暂无风险。")
  } 否则 {
    循环 每个 在 风险们 {
      行们 = 追加(行们, 填充("- {}", 每个))
    }
  }

  如果 无效记录.长度 大于 0 {
    行们 = 追加(行们, "")
    行们 = 追加(行们, "## 数据质量问题")
    循环 每个 在 无效记录 {
      行们 = 追加(行们, 填充("- {}", 每个))
    }
  }

  返回 拼接列表(码字符(10), 行们)
}

函数 主入口() 效应 读写 {
  变量 原始订单们 = [
    订单(单号: "SO-2001", 客户: "青荷书店", 区域: "华东", 金额: 128.5, 状态: "已完成"),
    订单(单号: "SO-2002", 客户: "远山咖啡", 区域: "华东", 金额: 86.0, 状态: "已完成"),
    订单(单号: "SO-2003", 客户: "南风文具", 区域: "华南", 金额: 42.0, 状态: "已取消"),
    订单(单号: "SO-2004", 客户: "青荷书店", 区域: "华东", 金额: 199.9, 状态: "已完成"),
    订单(单号: "SO-2005", 客户: "晨光设计", 区域: "华北", 金额: 310.0, 状态: "待付款"),
    订单(单号: "SO-2006", 客户: "远山咖啡", 区域: "华南", 金额: 156.0, 状态: "已完成"),
    订单(单号: "SO-2007", 客户: "木棉科技", 区域: "华南", 金额: 420.0, 状态: "已完成"),
    订单(单号: "SO-2008", 客户: "木棉科技", 区域: "华北", 金额: 275.0, 状态: "已完成"),
    订单(单号: "SO-2009", 客户: "青荷书店", 区域: "华北", 金额: -30.0, 状态: "已完成"),
    订单(单号: "SO-2010", 客户: "晨光设计", 区域: "华东", 金额: 64.0, 状态: "未知")
  ]

  变量 预算表 = [
    区域预算(区域: "华东", 预算: 500.0),
    区域预算(区域: "华南", 预算: 600.0),
    区域预算(区域: "华北", 预算: 400.0)
  ]

  变量 有效订单们 = []
  变量 无效记录 = []

  循环 每个 在 原始订单们 {
    变量 检查结果 = 校验订单(每个)
    如果 检查结果 {
      有效订单们 = 追加(有效订单们, 取到(检查结果))
    } 否则 {
      无效记录 = 追加(无效记录, 填充("{}：{}", 每个.单号, 失败原因(检查结果)))
    }
  }

  变量 区域名单 = ["华东", "华南", "华北"]
  变量 区域结果们 = []

  循环 每个 在 区域名单 {
    区域结果们 = 追加(区域结果们, 汇总区域(有效订单们, 每个, 预算表))
  }

  变量 总收入 = 0.0
  变量 总预算 = 0.0

  循环 每个 在 区域结果们 {
    总收入 = 总收入 + 每个.收入
    总预算 = 总预算 + 每个.预算
  }

  变量 报告 = 生成报告(区域结果们, 有效订单们, 无效记录, 总预算, 总收入)
  变量 报告路径 = 路径拼接("examples", "zh", "04_经营分析报告.md")
  变量 写入 = 写文件(报告路径, 报告)

  打印(报告)
  打印("")
  如果 写入 {
    打印("报告已写入：", 报告路径)
  } 否则 {
    打印("报告写入失败：", 失败原因(写入))
  }
}
