#语言=中文
// 销售日报：结构体、列表、循环、函数、条件与数值格式化。
// 运行：python -m compiler.cli run examples/zh/01_销售日报.agl

类型 订单 {
  单号: 文本
  客户: 文本
  金额: 浮数
  状态: 文本
}

函数 是否完成(订单: 订单) -> 布尔 {
  返回 订单.状态 等于 "已完成"
}

函数 主入口() {
  变量 订单们 = [
    订单(单号: "SO-1001", 客户: "青荷书店", 金额: 128.5, 状态: "已完成"),
    订单(单号: "SO-1002", 客户: "远山咖啡", 金额: 86.0, 状态: "已完成"),
    订单(单号: "SO-1003", 客户: "南风文具", 金额: 42.0, 状态: "已取消"),
    订单(单号: "SO-1004", 客户: "青荷书店", 金额: 199.9, 状态: "已完成"),
    订单(单号: "SO-1005", 客户: "晨光设计", 金额: 310.0, 状态: "待付款")
  ]

  变量 完成单数 = 0
  变量 完成金额 = 0.0
  循环 每个 在 订单们 {
    如果 是否完成(每个) {
      完成单数 = 完成单数 + 1
      完成金额 = 完成金额 + 每个.金额
    }
  }

  变量 完成率 = 0.0
  如果 订单们.长度 大于 0 {
    完成率 = 完成单数 / 订单们.长度 * 100.0
  }

  打印("销售日报")
  打印("总订单：", 订单们.长度, " 单；已完成：", 完成单数, " 单")
  打印("完成金额：", 格式化数字(完成金额, 2), " 元")
  打印("完成率：", 格式化数字(完成率, 1), "%")
  打印("")
  打印("单号       客户        金额      状态")
  循环 每个 在 订单们 {
    打印(每个.单号, 每个.客户, 格式化数字(每个.金额, 2), 每个.状态)
  }
}
